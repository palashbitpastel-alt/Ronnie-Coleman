{%- liquid
  assign heading_text = section.settings.heading

  assign heading_font = section.settings.heading_font
  assign title_font = section.settings.title_font
  assign cta_font = section.settings.cta_font
-%}

{%- style -%}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ title_font | font_face: font_display: 'swap' }}
  {{ cta_font | font_face: font_display: 'swap' }}

  .section-rc-shop-by-category-{{ section.id }} {
    --rc-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --rc-heading-weight: {{ heading_font.weight }};
    --rc-heading-style: {{ heading_font.style }};
    --rc-title-family: {{ title_font.family }}, {{ title_font.fallback_families }};
    --rc-title-weight: {{ title_font.weight }};
    --rc-title-style: {{ title_font.style }};
    --rc-cta-family: {{ cta_font.family }}, {{ cta_font.fallback_families }};
    --rc-cta-weight: {{ cta_font.weight }};
    --rc-cta-style: {{ cta_font.style }};
    --rc-bg: {{ section.settings.background_color }};
    --rc-heading-color: {{ section.settings.heading_color }};
    --rc-tile-text: {{ section.settings.tile_text_color }};
    --rc-tile-overlay: {{ section.settings.tile_overlay_color }};
    --rc-cta-bg: {{ section.settings.cta_background }};
    --rc-cta-text: {{ section.settings.cta_text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="section-rc-shop-by-category-{{ section.id }} rc-shop-by-category">
  <div class="page-width rc-shop-by-category__inner">
    {%- if heading_text != blank -%}
      <h2 class="rc-shop-by-category__heading">{{ heading_text | escape }}</h2>
    {%- endif -%}

    <div class="rc-shop-by-category__list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign link = block.settings.link | default: '#'
          assign image = block.settings.image
          assign title = block.settings.title
          assign cta_label = block.settings.cta_label
        -%}
        <a href="{{ link }}" class="rc-shop-by-category__tile" {{ block.shopify_attributes }}>
          <div class="rc-shop-by-category__media">
            {%- if image != blank -%}
              {{ image | image_url: width: 2400 | image_tag:
                loading: 'lazy',
                widths: '600,900,1200,1800,2400',
                sizes: '(min-width: 1200px) 1466px, 100vw',
                alt: title,
                class: 'rc-shop-by-category__image'
              }}
            {%- endif -%}
            <span class="rc-shop-by-category__overlay" aria-hidden="true"></span>
          </div>
          <div class="rc-shop-by-category__content">
            {%- if title != blank -%}
              <h3 class="rc-shop-by-category__title">{{ title | escape }}</h3>
            {%- endif -%}
            {%- if cta_label != blank -%}
              <span class="rc-shop-by-category__cta">
                <span>{{ cta_label | escape }}</span>
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                  <path d="M5 12h14M13 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .section-rc-shop-by-category-{{ section.id }} {
    display: block;
    width: 100%;
    background-color: var(--rc-bg, #FFFFFF);
  }

  .section-rc-shop-by-category-{{ section.id }} .rc-shop-by-category__inner {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .section-rc-shop-by-category-{{ section.id }} .rc-shop-by-category__heading {
    margin: 0;
    font-family: var(--rc-heading-family);
    font-weight: var(--rc-heading-weight);
    font-style: var(--rc-heading-style);
    font-size: clamp(24px, 2.22vw, 32px);
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--rc-heading-color, #222222);
    text-align: left;
  }

  .section-rc-shop-by-category-{{ section.id }} .rc-shop-by-category__list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .section-rc-shop-by-category-{{ section.id }} .rc-shop-by-category__tile {
    position: relative;
    display: flex;
    align-items: center;
    aspect-ratio: 1466 / 160;
    min-height: 120px;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    isolation: isolate;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .section-rc-shop-by-category-{{ section.id }} .rc-shop-by-category__tile:hover,
  .section-rc-shop-by-category-{{ section.id }} .rc-shop-by-category__tile:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
    outline: none;
  }

  .section-rc-shop-by-category-{{ section.id }} .rc-shop-by-category__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .section-rc-shop-by-category-{{ section.id }} .rc-shop-by-category__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    transition: transform 0.5s ease;
  }

  .section-rc-shop-by-category-{{ section.id }} .rc-shop-by-category__tile:hover .rc-shop-by-category__image {
    transform: scale(1.03);
  }

  .section-rc-shop-by-category-{{ section.id }} .rc-shop-by-category__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--rc-tile-overlay, rgba(0, 0, 0, 0.55)) 0%, rgba(0, 0, 0, 0.15) 60%, rgba(0, 0, 0, 0) 100%);
    pointer-events: none;
  }

  .section-rc-shop-by-category-{{ section.id }} .rc-shop-by-category__content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    padding: 28px 48px;
    color: var(--rc-tile-text, #FFFFFF);
  }

  .section-rc-shop-by-category-{{ section.id }} .rc-shop-by-category__title {
    margin: 0;
    font-family: var(--rc-title-family);
    font-weight: var(--rc-title-weight);
    font-style: var(--rc-title-style);
    font-size: clamp(22px, 2.08vw, 32px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--rc-tile-text, #FFFFFF);
  }

  .section-rc-shop-by-category-{{ section.id }} .rc-shop-by-category__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 28px;
    background-color: var(--rc-cta-bg, #1A4083);
    color: var(--rc-cta-text, #FFFFFF);
    border-radius: 999px;
    font-family: var(--rc-cta-family);
    font-weight: var(--rc-cta-weight);
    font-style: var(--rc-cta-style);
    font-size: 14px;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    flex: 0 0 auto;
    transition: filter 0.2s ease, transform 0.2s ease;
  }

  .section-rc-shop-by-category-{{ section.id }} .rc-shop-by-category__tile:hover .rc-shop-by-category__cta {
    filter: brightness(1.12);
  }

  @media screen and (max-width: 749px) {
    .section-rc-shop-by-category-{{ section.id }} .rc-shop-by-category__tile {
      aspect-ratio: auto;
      min-height: 160px;
    }
    .section-rc-shop-by-category-{{ section.id }} .rc-shop-by-category__content {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      padding: 22px;
    }
    .section-rc-shop-by-category-{{ section.id }} .rc-shop-by-category__overlay {
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.7) 100%);
    }
    .section-rc-shop-by-category-{{ section.id }} .rc-shop-by-category__cta {
      padding: 12px 22px;
      font-size: 13px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-rc-shop-by-category-{{ section.id }} .rc-shop-by-category__tile,
    .section-rc-shop-by-category-{{ section.id }} .rc-shop-by-category__image,
    .section-rc-shop-by-category-{{ section.id }} .rc-shop-by-category__cta {
      transition: none;
    }
    .section-rc-shop-by-category-{{ section.id }} .rc-shop-by-category__tile:hover,
    .section-rc-shop-by-category-{{ section.id }} .rc-shop-by-category__tile:hover .rc-shop-by-category__image {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by category (rc)",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP BY CATEGORY"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "helvetica_n7"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Tile title font",
      "default": "helvetica_n7"
    },
    {
      "type": "font_picker",
      "id": "cta_font",
      "label": "Button font",
      "default": "helvetica_n7"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "tile_text_color",
      "label": "Tile text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "tile_overlay_color",
      "label": "Tile overlay",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "cta_background",
      "label": "Button background",
      "default": "#1A4083"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "SUPPLEMENTS"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by category (rc)",
      "category": "Image",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "SUPPLEMENTS",
            "cta_label": "Shop Now"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "BUNDLES",
            "cta_label": "Shop Now"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "APPAREL",
            "cta_label": "Shop Now"
          }
        }
      ]
    }
  ]
}
{% endschema %}
