{{ 'section-collection-list.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_font = section.settings.heading_font
  assign title_font = section.settings.title_font
  assign cta_font = section.settings.cta_font
-%}

{%- style -%}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ title_font | font_face: font_display: 'swap' }}
  {{ cta_font | font_face: font_display: 'swap' }}

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .rc-sbc-{{ section.id }} {
    --rc-sbc-arrow-color: {{ section.settings.slider_arrow_color }};
    --rc-sbc-title-family: {{ title_font.family }}, {{ title_font.fallback_families }};
    --rc-sbc-title-weight: {{ title_font.weight }};
    --rc-sbc-title-style: {{ title_font.style }};
    --rc-sbc-cta-family: {{ cta_font.family }}, {{ cta_font.fallback_families }};
    --rc-sbc-cta-weight: {{ cta_font.weight }};
    --rc-sbc-cta-style: {{ cta_font.style }};
  }

  .rc-sbc-{{ section.id }} .rc-sbc-title-row {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .rc-sbc-{{ section.id }} .rc-sbc-title-row .collection-list-title {
    margin: 0;
    flex: 1 1 auto;
  }

  .rc-sbc-{{ section.id }} .rc-sbc-title-row .slider-buttons {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding: 0;
    margin: 0 0 0 auto;
  }

  .rc-sbc-{{ section.id }} .rc-sbc-title-row .slider-button {
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: 0;
    color: var(--rc-sbc-arrow-color, #1A4083);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .rc-sbc-{{ section.id }} .rc-sbc-title-row .slider-button[disabled] {
    opacity: 0.5;
    cursor: default;
  }

  .rc-sbc-{{ section.id }} .rc-sbc-title-row .slider-button:hover:not([disabled]) {
    transform: translateY(-1px);
  }

  .rc-sbc-{{ section.id }} .rc-sbc-title-row .slider-button svg {
    width: 30px;
    height: 26px;
    display: block;
  }

  .rc-sbc-{{ section.id }} .rc-sbc-title-row .slider-counter {
    min-width: 44px;
    text-align: center;
  }

  /* Tile — matches Figma nodes 1:94962/1:94971/1:94980 */
  .rc-sbc-{{ section.id }} .rc-sbc-tile {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 465 / 578;
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    color: #FFFFFF;
    isolation: isolate;
    background-color: #111;
  }

  .rc-sbc-{{ section.id }} .rc-sbc-tile__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  .rc-sbc-{{ section.id }} .rc-sbc-tile__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(90deg, #000 11.89%, rgba(0, 0, 0, 0.00) 50%);
  }

  .rc-sbc-{{ section.id }} .rc-sbc-tile__content {
    position: absolute;
    left: 50%;
    bottom: 20%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
    width: min(80%, 260px);
  }

  .rc-sbc-{{ section.id }} .rc-sbc-tile__title {
    margin: 0;
    font-family: var(--rc-sbc-title-family);
    font-weight: 700;
    font-size: clamp(22px, 1.6vw, 32px);
    line-height: 0.995;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: #FFFFFF;
  }

  .rc-sbc-{{ section.id }} .rc-sbc-tile__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--rc-sbc-cta-family);
    font-weight: var(--rc-sbc-cta-weight);
    font-style: var(--rc-sbc-cta-style);
    font-size: clamp(14px, 1.1vw, 20px);
    letter-spacing: -0.04em;
    color: #FFFFFF;
    transition: transform 0.2s ease;
  }

  .rc-sbc-{{ section.id }} .rc-sbc-tile__cta svg {
    width: 24px;
    height: auto;
    display: block;
    transition: transform 0.2s ease;
  }

  .rc-sbc-{{ section.id }} .rc-sbc-tile:hover .rc-sbc-tile__cta svg {
    transform: translateX(4px);
  }
{%- endstyle -%}

{%- liquid
  assign columns_desktop = section.settings.columns_desktop | default: 3
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0

  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and section.blocks.size > columns_mobile_int
    assign show_mobile_slider = true
  endif

  assign show_desktop_slider = false
  if section.settings.enable_desktop_slider and section.blocks.size > columns_desktop
    assign show_desktop_slider = true
  endif

  assign is_slider = false
  if show_mobile_slider or show_desktop_slider
    assign is_slider = true
  endif
-%}

<div class="color-{{ section.settings.color_scheme }} gradient rc-sbc-{{ section.id }}">
  <div class="collection-list-wrapper page-width isolate{% if show_mobile_slider %} page-width-desktop{% endif %}{% if section.settings.title == blank %} no-heading{% endif %} section-{{ section.id }}-padding">
    <slider-component class="slider-mobile-gutter{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- unless section.settings.title == blank -%}
        <div class="title-wrapper-with-link{% if show_mobile_slider %} title-wrapper--self-padded-tablet-down{% else %} title-wrapper--self-padded-mobile{% endif %} title-wrapper--no-top-margin rc-sbc-title-row">
          <h2
            id="SectionHeading-{{ section.id }}"
            class="collection-list-title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          >
            {{ section.settings.title }}
          </h2>

          {%- if is_slider -%}
            <div class="slider-buttons">
              <button
                type="button"
                class="slider-button slider-button--prev"
                name="previous"
                aria-label="{{ 'general.slider.previous_slide' | t }}"
                aria-controls="Slider-{{ section.id }}"
              >
                {{- 'rc-slider-arrow-prev.svg' | inline_asset_content -}}
              </button>
              <div class="slider-counter caption">
                <span class="slider-counter--current">1</span>
                <span aria-hidden="true"> / </span>
                <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
                <span class="slider-counter--total">{{ section.blocks.size }}</span>
              </div>
              <button
                type="button"
                class="slider-button slider-button--next"
                name="next"
                aria-label="{{ 'general.slider.next_slide' | t }}"
                aria-controls="Slider-{{ section.id }}"
              >
                {{- 'rc-slider-arrow-next.svg' | inline_asset_content -}}
              </button>
            </div>
          {%- endif -%}
        </div>
      {%- endunless -%}

      <ul
        class="collection-list grid grid--{{ columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down{% if is_slider %} slider{% if show_desktop_slider %} slider--desktop{% endif %}{% if show_mobile_slider %} slider--tablet grid--peek{% endif %}{% endif %} collection-list--{{ section.blocks.size }}-items"
        id="Slider-{{ section.id }}"
        role="list"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign tile_collection = block.settings.collection
            assign tile_title = block.settings.title_override
            if tile_title == blank and tile_collection != blank
              assign tile_title = tile_collection.title
            endif
            assign tile_link = block.settings.link_override
            if tile_link == blank and tile_collection != blank
              assign tile_link = tile_collection.url
            endif
            if tile_link == blank
              assign tile_link = '#'
            endif
            assign tile_image = block.settings.image_override
            if tile_image == blank and tile_collection != blank
              assign tile_image = tile_collection.featured_image
            endif
            assign cta_label = block.settings.cta_label | default: 'Shop Now'
            assign placeholder_index = forloop.index0 | modulo: 4 | plus: 1
            assign placeholder_image = 'collection-apparel-' | append: placeholder_index
          -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="collection-list__item grid__item{% if is_slider %} slider__slide{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            <a href="{{ tile_link }}" class="rc-sbc-tile" aria-label="{{ tile_title | default: cta_label | escape }}">
              {%- if tile_image != blank -%}
                {{ tile_image | image_url: width: 1200 | image_tag:
                  loading: 'lazy',
                  widths: '300,500,700,900,1200',
                  sizes: '(min-width: 990px) calc(100vw / 3), (min-width: 750px) 50vw, 100vw',
                  alt: tile_title,
                  class: 'rc-sbc-tile__image'
                }}
              {%- else -%}
                {{ placeholder_image | placeholder_svg_tag: 'rc-sbc-tile__image placeholder-svg' }}
              {%- endif -%}

              <span class="rc-sbc-tile__overlay" aria-hidden="true"></span>

              <div class="rc-sbc-tile__content">
                {%- if tile_title != blank -%}
                  <h3 class="rc-sbc-tile__title">{{ tile_title | escape }}</h3>
                {%- endif -%}
                <span class="rc-sbc-tile__cta">
                  <span>{{ cta_label | escape }}</span>
                  {{- 'rc-hero-arrow-right.svg' | inline_asset_content -}}
                </span>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </slider-component>
  </div>
</div>

{% schema %}
{
  "name": "Shop by category (rc)",
  "tag": "section",
  "class": "section section-collection-list",
  "max_blocks": 15,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "",
      "label": "Heading",
      "info": "Leave blank to hide the heading row (Figma default)."
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" },
        { "value": "hxl", "label": "Extra large" },
        { "value": "hxxl", "label": "Extra extra large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "helvetica_n7"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Tile title font",
      "default": "helvetica_n7"
    },
    {
      "type": "font_picker",
      "id": "cta_font",
      "label": "\"Shop Now\" font",
      "default": "barlow_n7"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "Columns on desktop"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "checkbox",
      "id": "enable_desktop_slider",
      "label": "Enable slider on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "default": true,
      "label": "Enable swipe on mobile"
    },
    {
      "type": "color",
      "id": "slider_arrow_color",
      "label": "Slider arrow color",
      "default": "#1A4083"
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "1",
      "label": "Columns on mobile"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Uses the collection's title, featured image, and URL by default."
        },
        {
          "type": "header",
          "content": "Overrides"
        },
        {
          "type": "image_picker",
          "id": "image_override",
          "label": "Custom image",
          "info": "Overrides the collection's featured image."
        },
        {
          "type": "text",
          "id": "title_override",
          "label": "Custom title",
          "info": "Overrides the collection title."
        },
        {
          "type": "url",
          "id": "link_override",
          "label": "Custom link",
          "info": "Overrides the collection URL."
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "Shop Now"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by category (rc)",
      "category": "Collection",
      "blocks": [
        { "type": "category", "settings": { "title_override": "SUPPLIMENTS" } },
        { "type": "category", "settings": { "title_override": "Bundles" } },
        { "type": "category", "settings": { "title_override": "Apparel" } }
      ]
    }
  ]
}
{% endschema %}
