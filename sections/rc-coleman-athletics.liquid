{%- comment -%}
  RC Coleman Athletics
  Dark full-width apparel promo. Large headline + subtext + CTA on the left,
  apparel image on the right (merchant-uploaded via image_picker).
  Fonts: Helvetica Neue (heading), Barlow (subtext), Dancing Script as Manderley fallback (CTA).
{%- endcomment -%}

{%- comment -%} Google Fonts load (browser dedupes shared URL across sections) {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Dancing+Script:wght@400&display=swap">

{%- liquid
  assign bg_choice = section.settings.bg_color_choice | default: 'darkBg'
  assign bg_hex = '#0C0D16'
  if bg_choice == 'darkNavy'
    assign bg_hex = '#000E22'
  endif
-%}

{%- style -%}
  .rc-coleman-athletics-{{ section.id }} {
    width: 100%;
    padding: 5rem 1.25rem;
    background-color: {{ bg_hex }};
    color: #FFFFFF;
  }

  .rc-coleman-athletics-{{ section.id }} .rc-ca__inner {
    max-width: 80rem; /* 1280px */
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .rc-coleman-athletics-{{ section.id }} .rc-ca__content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .rc-coleman-athletics-{{ section.id }} .rc-ca__heading {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-weight: 700;
    font-size: 3.5rem; /* 56px */
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #FFFFFF;
    margin: 0;
  }

  .rc-coleman-athletics-{{ section.id }} .rc-ca__subheading {
    font-family: "Barlow", sans-serif;
    font-weight: 400;
    font-size: 1.25rem; /* 20px */
    line-height: 1.5;
    color: #F6F8FB;
    margin: 0;
    max-width: 32rem;
  }

  .rc-coleman-athletics-{{ section.id }} .rc-ca__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    align-self: flex-start;
    margin-top: 0.5rem;
    padding: 1rem 2rem;
    background-color: #EED427;
    color: #0C0D16;
    border-radius: 999px;
    border: none;
    text-decoration: none;
    font-family: "Manderley", "Dancing Script", "Playfair Display", serif;
    font-weight: 400;
    font-size: 1.25rem; /* 20px */
    line-height: 1;
    transition: transform 0.2s ease, background-color 0.2s ease;
    cursor: pointer;
  }

  .rc-coleman-athletics-{{ section.id }} .rc-ca__cta:hover {
    background-color: #FFE24A;
    transform: translateY(-2px);
  }

  .rc-coleman-athletics-{{ section.id }} .rc-ca__cta-arrow {
    display: inline-flex;
    width: 1.125rem;
    height: 1.125rem;
  }

  .rc-coleman-athletics-{{ section.id }} .rc-ca__cta-arrow svg {
    width: 100%;
    height: 100%;
    stroke: #0C0D16;
    fill: none;
  }

  .rc-coleman-athletics-{{ section.id }} .rc-ca__media {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .rc-coleman-athletics-{{ section.id }} .rc-ca__media img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 32rem;
    object-fit: contain;
  }

  .rc-coleman-athletics-{{ section.id }} .rc-ca__media-placeholder {
    width: 100%;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px dashed rgba(255, 255, 255, 0.25);
    color: #E0E5ED;
    font-family: "Barlow", sans-serif;
    font-size: 0.875rem;
    opacity: 0.6;
    border-radius: 0.75rem;
  }

  @media screen and (max-width: 989px) {
    .rc-coleman-athletics-{{ section.id }} {
      padding: 3.5rem 1.25rem;
    }

    .rc-coleman-athletics-{{ section.id }} .rc-ca__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .rc-coleman-athletics-{{ section.id }} .rc-ca__media {
      order: -1;
    }

    .rc-coleman-athletics-{{ section.id }} .rc-ca__heading {
      font-size: 2.25rem; /* 36px */
    }
  }

  @media screen and (max-width: 749px) {
    .rc-coleman-athletics-{{ section.id }} {
      padding: 3rem 1rem;
    }

    .rc-coleman-athletics-{{ section.id }} .rc-ca__heading {
      font-size: 2.25rem; /* 36px */
    }

    .rc-coleman-athletics-{{ section.id }} .rc-ca__subheading {
      font-size: 1rem;
    }

    .rc-coleman-athletics-{{ section.id }} .rc-ca__cta {
      padding: 0.875rem 1.5rem;
      font-size: 1.125rem;
    }
  }
{%- endstyle -%}

<section
  class="rc-coleman-athletics rc-coleman-athletics-{{ section.id }}"
  aria-label="{{ section.settings.heading | default: 'Coleman Athletics' | escape }}"
>
  <div class="rc-ca__inner">
    <div class="rc-ca__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="rc-ca__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="rc-ca__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          class="rc-ca__cta"
          href="{{ section.settings.button_link | default: '#' }}"
          aria-label="{{ section.settings.button_label | escape }}"
        >
          <span>{{ section.settings.button_label | escape }}</span>
          <span class="rc-ca__cta-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="4" y1="12" x2="20" y2="12"></line>
              <polyline points="13 5 20 12 13 19"></polyline>
            </svg>
          </span>
        </a>
      {%- endif -%}
    </div>

    <div class="rc-ca__media">
      {%- if section.settings.apparel_image != blank -%}
        {{
          section.settings.apparel_image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            widths: '480, 720, 960, 1200, 1600',
            sizes: '(min-width: 990px) 40vw, 92vw',
            alt: section.settings.heading | default: 'Coleman Athletics apparel'
        }}
      {%- else -%}
        <div class="rc-ca__media-placeholder">Upload apparel image in theme editor</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RC Coleman Athletics",
  "tag": "section",
  "class": "section rc-coleman-athletics-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "COLEMAN ATHLETICS"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Wear the grind. Train like a legend."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "apparel_image",
      "label": "Apparel image"
    },
    {
      "type": "select",
      "id": "bg_color_choice",
      "label": "Background color",
      "options": [
        { "value": "darkBg", "label": "Dark background (#0C0D16)" },
        { "value": "darkNavy", "label": "Dark navy (#000E22)" }
      ],
      "default": "darkBg"
    }
  ],
  "presets": [
    {
      "name": "RC Coleman Athletics",
      "settings": {
        "heading": "COLEMAN ATHLETICS",
        "subheading": "Wear the grind. Train like a legend.",
        "button_label": "Shop Now",
        "bg_color_choice": "darkBg"
      }
    }
  ]
}
{% endschema %}
