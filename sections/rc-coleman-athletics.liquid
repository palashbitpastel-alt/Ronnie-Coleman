{%- liquid
  assign heading_text = section.settings.heading
  assign heading_alignment = section.settings.heading_alignment
  assign show_dividers = section.settings.show_dividers
  assign columns_desktop = section.settings.columns_desktop | default: 4
  assign columns_tablet = section.settings.columns_tablet | default: 2
  assign columns_mobile = section.settings.columns_mobile | default: 1
  assign image_ratio = section.settings.image_ratio
  assign cta_label = section.settings.cta_label
  assign cta_link = section.settings.cta_link

  assign heading_font = section.settings.heading_font
  assign eyebrow_font = section.settings.eyebrow_font
  assign title_font = section.settings.title_font
  assign price_font = section.settings.price_font
  assign cta_font = section.settings.cta_font
-%}

{%- style -%}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ eyebrow_font | font_face: font_display: 'swap' }}
  {{ title_font | font_face: font_display: 'swap' }}
  {{ price_font | font_face: font_display: 'swap' }}
  {{ cta_font | font_face: font_display: 'swap' }}

  .section-rc-coleman-athletics-{{ section.id }} {
    --rc-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --rc-heading-weight: {{ heading_font.weight }};
    --rc-heading-style: {{ heading_font.style }};
    --rc-eyebrow-family: {{ eyebrow_font.family }}, {{ eyebrow_font.fallback_families }};
    --rc-eyebrow-weight: {{ eyebrow_font.weight }};
    --rc-eyebrow-style: {{ eyebrow_font.style }};
    --rc-title-family: {{ title_font.family }}, {{ title_font.fallback_families }};
    --rc-title-weight: {{ title_font.weight }};
    --rc-title-style: {{ title_font.style }};
    --rc-price-family: {{ price_font.family }}, {{ price_font.fallback_families }};
    --rc-price-weight: {{ price_font.weight }};
    --rc-price-style: {{ price_font.style }};
    --rc-cta-family: {{ cta_font.family }}, {{ cta_font.fallback_families }};
    --rc-cta-weight: {{ cta_font.weight }};
    --rc-cta-style: {{ cta_font.style }};
    --rc-bg: {{ section.settings.background_color }};
    --rc-heading-color: {{ section.settings.heading_color }};
    --rc-line-color: {{ section.settings.line_color }};
    --rc-card-bg: {{ section.settings.card_background }};
    --rc-text-color: {{ section.settings.text_color }};
    --rc-glow-color: {{ section.settings.glow_color }};
    --rc-cta-bg: {{ section.settings.cta_background }};
    --rc-cta-text: {{ section.settings.cta_text_color }};
    --rc-card-radius: {{ section.settings.card_radius }}px;
    --rc-columns-desktop: {{ columns_desktop }};
    --rc-columns-tablet: {{ columns_tablet }};
    --rc-columns-mobile: {{ columns_mobile }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="section-rc-coleman-athletics-{{ section.id }} rc-coleman-athletics rc-coleman-athletics--align-{{ heading_alignment }} rc-coleman-athletics--ratio-{{ image_ratio }}{% if show_dividers %} rc-coleman-athletics--dividers{% endif %}">
  <div class="page-width rc-coleman-athletics__inner">
    {%- if heading_text != blank -%}
      <div class="rc-coleman-athletics__heading-row">
        {%- if show_dividers -%}<span class="rc-coleman-athletics__line" aria-hidden="true"></span>{%- endif -%}
        <h2 class="rc-coleman-athletics__heading">{{ heading_text | escape }}</h2>
        {%- if show_dividers -%}<span class="rc-coleman-athletics__line" aria-hidden="true"></span>{%- endif -%}
      </div>
    {%- endif -%}

    <ul class="rc-coleman-athletics__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_link = block.settings.link | default: '#'
          assign card_image = block.settings.image
          assign card_eyebrow = block.settings.eyebrow
          assign card_title = block.settings.title
          assign card_price = block.settings.price_label
        -%}
        <li class="rc-coleman-athletics__item" {{ block.shopify_attributes }}>
          <a href="{{ card_link }}" class="rc-coleman-athletics__card">
            <div class="rc-coleman-athletics__media">
              <span class="rc-coleman-athletics__glow" aria-hidden="true"></span>
              {%- if card_image != blank -%}
                {{ card_image | image_url: width: 800 | image_tag:
                  loading: 'lazy',
                  widths: '200,300,400,600,800',
                  sizes: '(min-width: 990px) calc(100vw / var(--rc-columns-desktop)), (min-width: 750px) calc(100vw / var(--rc-columns-tablet)), 100vw',
                  alt: card_title,
                  class: 'rc-coleman-athletics__image'
                }}
              {%- else -%}
                <div class="rc-coleman-athletics__placeholder" aria-hidden="true">
                  {{ 'product-apparel-1' | placeholder_svg_tag: 'rc-coleman-athletics__placeholder-svg' }}
                </div>
              {%- endif -%}
            </div>
            <div class="rc-coleman-athletics__body">
              {%- if card_eyebrow != blank -%}
                <p class="rc-coleman-athletics__eyebrow">{{ card_eyebrow | escape }}</p>
              {%- endif -%}
              <div class="rc-coleman-athletics__meta">
                {%- if card_title != blank -%}
                  <h3 class="rc-coleman-athletics__title">{{ card_title | escape }}</h3>
                {%- endif -%}
                {%- if card_price != blank -%}
                  <span class="rc-coleman-athletics__price">{{ card_price | escape }}</span>
                {%- endif -%}
              </div>
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {%- if cta_label != blank -%}
      <div class="rc-coleman-athletics__cta-wrap">
        <a class="rc-coleman-athletics__cta" href="{{ cta_link | default: '#' }}">
          <span>{{ cta_label | escape }}</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .section-rc-coleman-athletics-{{ section.id }} {
    display: block;
    width: 100%;
    background-color: var(--rc-bg, #FFFFFF);
  }

  .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__heading-row {
    display: flex;
    align-items: center;
    gap: 24px;
    width: 100%;
  }

  .section-rc-coleman-athletics--align-left .rc-coleman-athletics__heading-row { justify-content: flex-start; }
  .section-rc-coleman-athletics--align-center .rc-coleman-athletics__heading-row { justify-content: center; }
  .section-rc-coleman-athletics--align-right .rc-coleman-athletics__heading-row { justify-content: flex-end; }

  .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__line {
    flex: 1 1 auto;
    height: 1px;
    background-color: var(--rc-line-color, rgba(34, 34, 34, 0.2));
  }

  .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__heading {
    margin: 0;
    flex: 0 0 auto;
    font-family: var(--rc-heading-family);
    font-weight: var(--rc-heading-weight);
    font-style: var(--rc-heading-style);
    font-size: clamp(24px, 2.22vw, 32px);
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--rc-heading-color, #222222);
    text-align: center;
  }

  .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--rc-columns-desktop, 4), minmax(0, 1fr));
    gap: 24px;
  }

  .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__item {
    display: flex;
  }

  .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__card {
    display: flex;
    flex-direction: column;
    width: 100%;
    background-color: var(--rc-card-bg, #F6F8FB);
    border-radius: var(--rc-card-radius, 8px);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .section-rc-coleman-athletics--ratio-adapt .rc-coleman-athletics__card { aspect-ratio: 428 / 480; }
  .section-rc-coleman-athletics--ratio-square .rc-coleman-athletics__media { aspect-ratio: 1 / 1; }
  .section-rc-coleman-athletics--ratio-portrait .rc-coleman-athletics__media { aspect-ratio: 3 / 4; }
  .section-rc-coleman-athletics--ratio-landscape .rc-coleman-athletics__media { aspect-ratio: 4 / 3; }

  .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__card:hover,
  .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__card:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
    outline: none;
  }

  .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__media {
    position: relative;
    flex: 1 1 auto;
    overflow: hidden;
    isolation: isolate;
  }

  .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 70%;
    height: 70%;
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, var(--rc-glow-color, rgba(26, 64, 131, 0.4)) 0%, rgba(26, 64, 131, 0) 75%);
    filter: blur(24px);
    z-index: 0;
    pointer-events: none;
  }

  .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__image {
    position: relative;
    z-index: 1;
    display: block;
    width: 80%;
    height: 80%;
    margin: 10% auto 0;
    object-fit: contain;
    transition: transform 0.4s ease;
  }

  .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__placeholder {
    position: relative;
    z-index: 1;
    width: 80%;
    height: 80%;
    margin: 10% auto 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__placeholder-svg {
    width: 100%;
    height: 100%;
    fill: rgba(34, 34, 34, 0.2);
  }

  .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__card:hover .rc-coleman-athletics__image {
    transform: scale(1.04);
  }

  .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 24px 28px;
  }

  .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__eyebrow {
    margin: 0;
    font-family: var(--rc-eyebrow-family);
    font-weight: var(--rc-eyebrow-weight);
    font-style: var(--rc-eyebrow-style);
    font-size: 14px;
    line-height: 1.2;
    color: var(--rc-text-color, #222222);
    opacity: 0.8;
  }

  .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__title {
    margin: 0;
    flex: 1 1 auto;
    font-family: var(--rc-title-family);
    font-weight: var(--rc-title-weight);
    font-style: var(--rc-title-style);
    font-size: 18px;
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--rc-text-color, #222222);
  }

  .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__price {
    flex: 0 0 auto;
    font-family: var(--rc-price-family);
    font-weight: var(--rc-price-weight);
    font-style: var(--rc-price-style);
    font-size: 18px;
    line-height: 1.2;
    color: var(--rc-text-color, #222222);
    white-space: nowrap;
  }

  .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__cta-wrap {
    display: flex;
    justify-content: center;
    margin-top: 8px;
  }

  .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    max-width: 358px;
    padding: 18px 32px;
    background-color: var(--rc-cta-bg, #1A4083);
    color: var(--rc-cta-text, #FFFFFF);
    border-radius: 4px;
    text-decoration: none;
    font-family: var(--rc-cta-family);
    font-weight: var(--rc-cta-weight);
    font-style: var(--rc-cta-style);
    font-size: 16px;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: filter 0.2s ease, transform 0.2s ease;
  }

  .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__cta:hover,
  .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__cta:focus-visible {
    filter: brightness(1.12);
    transform: translateY(-1px);
    outline: none;
  }

  @media screen and (max-width: 989px) {
    .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__grid {
      grid-template-columns: repeat(var(--rc-columns-tablet, 2), minmax(0, 1fr));
      gap: 16px;
    }
    .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__heading-row {
      gap: 16px;
    }
  }

  @media screen and (max-width: 749px) {
    .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__inner {
      gap: 24px;
    }
    .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__grid {
      grid-template-columns: repeat(var(--rc-columns-mobile, 1), minmax(0, 1fr));
    }
    .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__body {
      padding: 14px 16px 20px;
    }
    .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__title,
    .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__price {
      font-size: 15px;
    }
    .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__eyebrow {
      font-size: 12px;
    }
    .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__cta {
      padding: 14px 20px;
      font-size: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__card,
    .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__image,
    .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__cta {
      transition: none;
    }
    .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__card:hover,
    .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__cta:hover {
      transform: none;
    }
    .section-rc-coleman-athletics-{{ section.id }} .rc-coleman-athletics__card:hover .rc-coleman-athletics__image {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Coleman Athletics (rc)",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "COLEMAN ATHLETICS"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Show divider lines beside heading",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_tablet",
      "label": "Columns on tablet",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to card" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ],
      "default": "adapt"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "helvetica_n7"
    },
    {
      "type": "font_picker",
      "id": "eyebrow_font",
      "label": "Eyebrow font",
      "default": "barlow_n4"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Product title font",
      "default": "barlow_n7"
    },
    {
      "type": "font_picker",
      "id": "price_font",
      "label": "Price font",
      "default": "barlow_n7"
    },
    {
      "type": "font_picker",
      "id": "cta_font",
      "label": "Button font",
      "default": "helvetica_n7"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "line_color",
