        },
        {
          "type": "text",
          "id": "title",
          "label": "Product title",
          "default": "LIGHT WEIGHT BABY T-shirt"
        },
        {
          "type": "text",
          "id": "price_label",
          "label": "Price label",
          "default": "From $39.99"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Product link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Coleman Athletics (rc)",
      "category": "Product",
      "blocks": [
        { "type": "product", "settings": { "title": "LIGHT WEIGHT BABY T-shirt", "price_label": "From $39.99" } },
        { "type": "product", "settings": { "title": "LIGHT WEIGHT BABY Hoodie", "price_label": "From $79.99" } },
        { "type": "product", "settings": { "title": "LWB \"Blurred Lines\" Hoodie", "price_label": "From $79.99" } },
        { "type": "product", "settings": { "title": "YEAH BUDDY™ Hoodie", "price_label": "From $79.99" } }
      ]
    }
  ]
}
{% endschema %}
