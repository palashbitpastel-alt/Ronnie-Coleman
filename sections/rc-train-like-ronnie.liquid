{{ 'rc-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_text = section.settings.heading
  assign subheading_text = section.settings.subheading
  assign cta_label = section.settings.cta_label
  assign cta_link = section.settings.cta_link
  assign alt_text = section.settings.alt_text | default: heading_text

  assign heading_font = section.settings.heading_font
  assign subheading_font = section.settings.subheading_font
  assign cta_font = section.settings.cta_font
-%}

{%- style -%}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ subheading_font | font_face: font_display: 'swap' }}
  {{ cta_font | font_face: font_display: 'swap' }}

  .section-rc-train-like-ronnie-{{ section.id }} {
    --rc-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --rc-heading-weight: {{ heading_font.weight }};
    --rc-heading-style: {{ heading_font.style }};
    --rc-subheading-family: {{ subheading_font.family }}, {{ subheading_font.fallback_families }};
    --rc-subheading-weight: {{ subheading_font.weight }};
    --rc-subheading-style: {{ subheading_font.style }};
    --rc-cta-family: {{ cta_font.family }}, {{ cta_font.fallback_families }};
    --rc-cta-weight: {{ cta_font.weight }};
    --rc-cta-style: {{ cta_font.style }};
    --rc-text-color: {{ section.settings.text_color }};
    --rc-cta-bg: {{ section.settings.cta_background }};
    --rc-cta-text: {{ section.settings.cta_text_color }};
    --rc-scrim-color: {{ section.settings.scrim_color }};
    --rc-scrim-opacity: {{ section.settings.scrim_opacity | divided_by: 100.0 }};
  }
{%- endstyle -%}

<section class="section-rc-train-like-ronnie-{{ section.id }} rc-train-like-ronnie rc-train-like-ronnie--scrim-{{ section.settings.scrim_side }} rc-train-like-ronnie--height-{{ section.settings.banner_height }}">
  <div class="rc-train-like-ronnie__frame">
    <div class="rc-train-like-ronnie__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 3840 | image_tag:
          loading: 'lazy',
          widths: '480,768,1024,1440,1920,2560,3840',
          sizes: '100vw',
          alt: alt_text,
          class: 'rc-train-like-ronnie__image',
          width: section.settings.image.width,
          height: section.settings.image.height
        }}
      {%- endif -%}
    </div>

    <div class="rc-train-like-ronnie__scrim" aria-hidden="true"></div>

    <div class="page-width rc-train-like-ronnie__wrapper">
      <div class="rc-train-like-ronnie__content">
        {%- if heading_text != blank -%}
          <h2 class="rc-train-like-ronnie__heading">{{ heading_text | escape }}</h2>
        {%- endif -%}
        {%- if subheading_text != blank -%}
          <p class="rc-train-like-ronnie__subheading">{{ subheading_text | escape }}</p>
        {%- endif -%}
        {%- if cta_label != blank -%}
          <a class="rc-train-like-ronnie__cta" href="{{ cta_link | default: '#' }}">
            <span>{{ cta_label | escape }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Train like Ronnie banner (rc)",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wanna train like Ronnie?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Check out the awesome stuff made by a legend!"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "helvetica_n7"
    },
    {
      "type": "font_picker",
      "id": "subheading_font",
      "label": "Subheading font",
      "default": "helvetica_n4"
    },
    {
      "type": "font_picker",
      "id": "cta_font",
      "label": "Button font",
      "default": "barlow_n7"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout & overlay"
    },
    {
      "type": "select",
      "id": "banner_height",
      "label": "Banner height",
      "options": [
        { "value": "short", "label": "Short (420px at 1920w)" },
        { "value": "medium", "label": "Medium (560px)" },
        { "value": "tall", "label": "Tall (720px)" },
        { "value": "full", "label": "Full viewport (80vh)" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "scrim_side",
      "label": "Text & scrim position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "scrim_opacity",
      "label": "Scrim opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "scrim_color",
      "label": "Scrim color",
      "default": "#020101"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cta_background",
      "label": "Button background",
      "default": "#1A4083"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Train like Ronnie banner (rc)",
      "category": "Image",
      "settings": {
        "heading": "Wanna train like Ronnie?",
        "subheading": "Check out the awesome stuff made by a legend!",
        "cta_label": "SHOP NOW",
        "scrim_side": "left"
      }
    }
  ]
}
{% endschema %}
