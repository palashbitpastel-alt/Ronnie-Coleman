    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "barlow_n4"
    },
    {
      "type": "font_picker",
      "id": "name_font",
      "label": "Name font",
      "default": "barlow_n7"
    },
    {
      "type": "font_picker",
      "id": "cta_font",
      "label": "Button font",
      "default": "helvetica_n7"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_background",
