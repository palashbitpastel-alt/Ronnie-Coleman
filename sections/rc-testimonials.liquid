{%- liquid
  assign heading_text = section.settings.heading
  assign subheading_text = section.settings.subheading
  assign heading_alignment = section.settings.heading_alignment
  assign content_alignment = section.settings.content_alignment
  assign columns_desktop = section.settings.columns_desktop | default: 3
  assign columns_tablet = section.settings.columns_tablet | default: 2
  assign columns_mobile = section.settings.columns_mobile | default: 1
  assign show_stars = section.settings.show_stars
  assign show_avatars = section.settings.show_avatars
  assign cta_label = section.settings.cta_label
  assign cta_link = section.settings.cta_link

  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font
  assign name_font = section.settings.name_font
  assign cta_font = section.settings.cta_font
-%}

{%- style -%}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ name_font | font_face: font_display: 'swap' }}
  {{ cta_font | font_face: font_display: 'swap' }}

  .section-rc-testimonials-{{ section.id }} {
    --rc-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --rc-heading-weight: {{ heading_font.weight }};
    --rc-heading-style: {{ heading_font.style }};
    --rc-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    --rc-body-weight: {{ body_font.weight }};
    --rc-body-style: {{ body_font.style }};
    --rc-name-family: {{ name_font.family }}, {{ name_font.fallback_families }};
    --rc-name-weight: {{ name_font.weight }};
    --rc-name-style: {{ name_font.style }};
    --rc-cta-family: {{ cta_font.family }}, {{ cta_font.fallback_families }};
    --rc-cta-weight: {{ cta_font.weight }};
    --rc-cta-style: {{ cta_font.style }};
    --rc-bg: {{ section.settings.background_color }};
    --rc-heading-color: {{ section.settings.heading_color }};
    --rc-text-color: {{ section.settings.text_color }};
    --rc-star-color: {{ section.settings.star_color }};
    --rc-card-bg: {{ section.settings.card_background }};
    --rc-card-radius: {{ section.settings.card_radius }}px;
    --rc-cta-bg: {{ section.settings.cta_background }};
    --rc-cta-text: {{ section.settings.cta_text_color }};
    --rc-columns-desktop: {{ columns_desktop }};
    --rc-columns-tablet: {{ columns_tablet }};
    --rc-columns-mobile: {{ columns_mobile }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="section-rc-testimonials-{{ section.id }} rc-testimonials rc-testimonials--heading-{{ heading_alignment }} rc-testimonials--content-{{ content_alignment }}">
  <div class="page-width rc-testimonials__inner">
    <header class="rc-testimonials__header">
      {%- if heading_text != blank -%}
        <h2 class="rc-testimonials__heading">{{ heading_text | escape }}</h2>
      {%- endif -%}
      {%- if subheading_text != blank -%}
        <p class="rc-testimonials__subheading">{{ subheading_text | escape }}</p>
      {%- endif -%}
    </header>

    <ul class="rc-testimonials__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign stars = block.settings.rating | default: 5
          assign quote = block.settings.quote
          assign name = block.settings.name
          assign avatar = block.settings.avatar
        -%}
        <li class="rc-testimonials__item" {{ block.shopify_attributes }}>
          <article class="rc-testimonials__card">
            {%- if show_stars -%}
              <div class="rc-testimonials__stars" aria-label="Rated {{ stars }} out of 5">
                {%- for i in (1..5) -%}
                  {%- if i <= stars -%}
                    <svg class="rc-testimonials__star rc-testimonials__star--filled" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                      <path d="M12 2.5l2.95 5.98 6.6.96-4.78 4.66 1.13 6.58L12 17.58l-5.9 3.1 1.13-6.58L2.45 9.44l6.6-.96L12 2.5z" fill="currentColor"/>
                    </svg>
                  {%- else -%}
                    <svg class="rc-testimonials__star rc-testimonials__star--empty" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                      <path d="M12 2.5l2.95 5.98 6.6.96-4.78 4.66 1.13 6.58L12 17.58l-5.9 3.1 1.13-6.58L2.45 9.44l6.6-.96L12 2.5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                    </svg>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- if quote != blank -%}
              <blockquote class="rc-testimonials__quote">{{ quote }}</blockquote>
            {%- endif -%}

            <footer class="rc-testimonials__person">
              {%- if show_avatars -%}
                <span class="rc-testimonials__avatar">
                  {%- if avatar != blank -%}
                    {{ avatar | image_url: width: 180 | image_tag:
                      loading: 'lazy',
                      widths: '90,180',
                      sizes: '90px',
                      alt: name,
                      class: 'rc-testimonials__avatar-image'
                    }}
                  {%- else -%}
                    <svg viewBox="0 0 90 90" width="90" height="90" aria-hidden="true" focusable="false">
                      <circle cx="45" cy="45" r="45" fill="#E3E7EE"/>
                      <circle cx="45" cy="36" r="16" fill="#B9C1CC"/>
                      <path d="M15 80c4-16 16-24 30-24s26 8 30 24" fill="#B9C1CC"/>
                    </svg>
                  {%- endif -%}
                </span>
              {%- endif -%}
              {%- if name != blank -%}
                <span class="rc-testimonials__name">{{ name | escape }}</span>
              {%- endif -%}
            </footer>
          </article>
        </li>
      {%- endfor -%}
    </ul>

    {%- if cta_label != blank -%}
      <div class="rc-testimonials__cta-wrap">
        <a class="rc-testimonials__cta" href="{{ cta_link | default: '#' }}">
          <span>{{ cta_label | escape }}</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .section-rc-testimonials-{{ section.id }} {
    display: block;
    width: 100%;
    background-color: var(--rc-bg, #FFFFFF);
  }

  .section-rc-testimonials-{{ section.id }} .rc-testimonials__inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
    align-items: center;
  }

  .section-rc-testimonials-{{ section.id }} .rc-testimonials__header {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 760px;
    width: 100%;
  }

  .section-rc-testimonials--heading-left .rc-testimonials__header { text-align: left; align-self: flex-start; }
  .section-rc-testimonials--heading-center .rc-testimonials__header { text-align: center; align-self: center; }
  .section-rc-testimonials--heading-right .rc-testimonials__header { text-align: right; align-self: flex-end; }

  .section-rc-testimonials-{{ section.id }} .rc-testimonials__heading {
    margin: 0;
    font-family: var(--rc-heading-family);
    font-weight: var(--rc-heading-weight);
    font-style: var(--rc-heading-style);
    font-size: clamp(24px, 2.22vw, 32px);
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--rc-heading-color, #222222);
  }

  .section-rc-testimonials-{{ section.id }} .rc-testimonials__subheading {
    margin: 0;
    font-family: var(--rc-body-family);
    font-weight: var(--rc-body-weight);
    font-style: var(--rc-body-style);
    font-size: clamp(14px, 1.05vw, 18px);
    line-height: 1.5;
    color: var(--rc-text-color, #222222);
    opacity: 0.8;
  }

  .section-rc-testimonials-{{ section.id }} .rc-testimonials__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--rc-columns-desktop, 3), minmax(0, 1fr));
    gap: 24px;
    width: 100%;
  }

  .section-rc-testimonials-{{ section.id }} .rc-testimonials__item {
    display: flex;
  }

  .section-rc-testimonials-{{ section.id }} .rc-testimonials__card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
    padding: 36px 28px;
    background-color: var(--rc-card-bg, transparent);
    border-radius: var(--rc-card-radius, 12px);
  }

  .section-rc-testimonials--content-left .rc-testimonials__card { text-align: left; align-items: flex-start; }
  .section-rc-testimonials--content-center .rc-testimonials__card { text-align: center; align-items: center; }
  .section-rc-testimonials--content-right .rc-testimonials__card { text-align: right; align-items: flex-end; }

  .section-rc-testimonials-{{ section.id }} .rc-testimonials__stars {
    display: inline-flex;
    gap: 4px;
    color: var(--rc-star-color, #EED427);
  }

  .section-rc-testimonials-{{ section.id }} .rc-testimonials__star--empty {
    color: rgba(34, 34, 34, 0.25);
  }

  .section-rc-testimonials-{{ section.id }} .rc-testimonials__quote {
    margin: 0;
    font-family: var(--rc-body-family);
    font-weight: var(--rc-body-weight);
    font-style: var(--rc-body-style);
    font-size: clamp(14px, 1.05vw, 18px);
    line-height: 1.6;
    color: var(--rc-text-color, #222222);
  }

  .section-rc-testimonials-{{ section.id }} .rc-testimonials__person {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: auto;
  }

  .section-rc-testimonials--content-left .rc-testimonials__person { align-items: flex-start; }
  .section-rc-testimonials--content-center .rc-testimonials__person { align-items: center; }
  .section-rc-testimonials--content-right .rc-testimonials__person { align-items: flex-end; }

  .section-rc-testimonials-{{ section.id }} .rc-testimonials__avatar {
    display: block;
    width: 90px;
    height: 90px;
    border-radius: 50%;
    overflow: hidden;
    background-color: #E3E7EE;
  }

  .section-rc-testimonials-{{ section.id }} .rc-testimonials__avatar-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .section-rc-testimonials-{{ section.id }} .rc-testimonials__name {
    font-family: var(--rc-name-family);
    font-weight: var(--rc-name-weight);
    font-style: var(--rc-name-style);
    font-size: 18px;
    line-height: 1.2;
    color: var(--rc-text-color, #222222);
  }

  .section-rc-testimonials-{{ section.id }} .rc-testimonials__cta-wrap {
    display: flex;
    justify-content: center;
  }

  .section-rc-testimonials-{{ section.id }} .rc-testimonials__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 193px;
    padding: 18px 32px;
    background-color: var(--rc-cta-bg, #1A4083);
    color: var(--rc-cta-text, #FFFFFF);
    border-radius: 4px;
    text-decoration: none;
    font-family: var(--rc-cta-family);
    font-weight: var(--rc-cta-weight);
    font-style: var(--rc-cta-style);
    font-size: 16px;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: filter 0.2s ease, transform 0.2s ease;
  }

  .section-rc-testimonials-{{ section.id }} .rc-testimonials__cta:hover,
  .section-rc-testimonials-{{ section.id }} .rc-testimonials__cta:focus-visible {
    filter: brightness(1.12);
    transform: translateY(-1px);
    outline: none;
  }

  @media screen and (max-width: 989px) {
    .section-rc-testimonials-{{ section.id }} .rc-testimonials__grid {
      grid-template-columns: repeat(var(--rc-columns-tablet, 2), minmax(0, 1fr));
      gap: 16px;
    }
    .section-rc-testimonials-{{ section.id }} .rc-testimonials__inner {
      gap: 32px;
    }
  }

  @media screen and (max-width: 749px) {
    .section-rc-testimonials-{{ section.id }} .rc-testimonials__grid {
      grid-template-columns: repeat(var(--rc-columns-mobile, 1), minmax(0, 1fr));
    }
    .section-rc-testimonials-{{ section.id }} .rc-testimonials__card {
      padding: 28px 20px;
    }
    .section-rc-testimonials-{{ section.id }} .rc-testimonials__avatar {
      width: 72px;
      height: 72px;
    }
    .section-rc-testimonials-{{ section.id }} .rc-testimonials__cta {
      width: 100%;
      padding: 14px 20px;
      font-size: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-rc-testimonials-{{ section.id }} .rc-testimonials__cta {
      transition: none;
    }
    .section-rc-testimonials-{{ section.id }} .rc-testimonials__cta:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Testimonials (rc)",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "TRUSTED BY MILLIONS OF ATHLETES WORLDWIDE"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "From everyday lifters to elite professionals RCSS fuels those who refuse to quit."
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Card content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_tablet",
      "label": "Columns on tablet",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
