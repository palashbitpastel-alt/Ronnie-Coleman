          "type": "inline_richtext",
          "id": "heading",
          "default": "Built to inspire. Made to perform.",
          "label": "Heading"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            { "value": "h2", "label": "Small" },
            { "value": "h1", "label": "Medium" },
            { "value": "h0", "label": "Large" },
            { "value": "hxl", "label": "Extra large" },
            { "value": "hxxl", "label": "XXL" }
          ],
          "default": "hxxl",
          "label": "Heading size"
        }
      ]
    },
    {
      "type": "text",
      "name": "Subtitle",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
