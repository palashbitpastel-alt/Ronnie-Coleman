{%- liquid
  assign alt_text = section.settings.alt_text | default: 'Ronnie Coleman hero banner'
  assign heading_text = section.settings.heading | default: 'YEAH BUDDY™ BUILT FOR WARRIORS'
  assign eyebrow_text = section.settings.eyebrow | default: 'Ronnie Coleman Signature Series'
  assign subheading_text = section.settings.subheading
  assign cta_label = section.settings.cta_label | default: 'SHOP NOW'
  assign cta_link = section.settings.cta_link | default: '/collections/all'

  assign trust_title = section.settings.trust_title | default: 'Trusted by Millions of Athletes Worldwide'
  assign trust_subtitle = section.settings.trust_subtitle
  assign trust_show = section.settings.show_trust_badge

  assign circle_width = section.settings.circle_width | default: 95
  assign circle_height = section.settings.circle_height | default: 95
  assign circle_gap = section.settings.circle_gap | default: 16

  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font
  assign eyebrow_font = section.settings.eyebrow_font
  assign cta_font = section.settings.cta_font
  assign trust_font = section.settings.trust_font
-%}

{%- style -%}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ eyebrow_font | font_face: font_display: 'swap' }}
  {{ cta_font | font_face: font_display: 'swap' }}
  {{ trust_font | font_face: font_display: 'swap' }}

  .section-rc-hero-banner-{{ section.id }} {
    --rc-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --rc-heading-weight: {{ heading_font.weight }};
    --rc-heading-style: {{ heading_font.style }};
    --rc-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    --rc-body-weight: {{ body_font.weight }};
    --rc-body-style: {{ body_font.style }};
    --rc-eyebrow-family: {{ eyebrow_font.family }}, {{ eyebrow_font.fallback_families }};
    --rc-eyebrow-weight: {{ eyebrow_font.weight }};
    --rc-eyebrow-style: {{ eyebrow_font.style }};
    --rc-cta-family: {{ cta_font.family }}, {{ cta_font.fallback_families }};
    --rc-cta-weight: {{ cta_font.weight }};
    --rc-cta-style: {{ cta_font.style }};
    --rc-trust-family: {{ trust_font.family }}, {{ trust_font.fallback_families }};
    --rc-trust-weight: {{ trust_font.weight }};
    --rc-trust-style: {{ trust_font.style }};
    --rc-circle-width: {{ circle_width }}px;
    --rc-circle-height: {{ circle_height }}px;
    --rc-circle-gap: {{ circle_gap }}px;
  }
{%- endstyle -%}

<section class="section-rc-hero-banner-{{ section.id }} rc-hero-banner">
  <div class="rc-hero-banner__frame">
    <div class="rc-hero-banner__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 3840 | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '480,768,1024,1440,1920,2560,3200,3840',
          sizes: '(min-width: 750px) 100vw, 100vw',
          alt: alt_text,
          class: 'rc-hero-banner__image',
          width: section.settings.image.width,
          height: section.settings.image.height
        }}
      {%- endif -%}

      <span class="rc-hero-banner__ellipse rc-hero-banner__ellipse--a" aria-hidden="true"></span>
      <span class="rc-hero-banner__ellipse rc-hero-banner__ellipse--b" aria-hidden="true"></span>
    </div>

    <div class="rc-hero-banner__scrim" aria-hidden="true"></div>

    <div class="rc-hero-banner__content">
      <div class="rc-hero-banner__text">
        {%- if trust_show -%}
          <div class="rc-hero-banner__trust">
            <span class="rc-hero-banner__trust-icon" aria-hidden="true">
              {%- if section.settings.trust_icon != blank -%}
                {{ section.settings.trust_icon | image_url: width: 64 | image_tag:
                  loading: 'eager',
                  widths: '32,48,64,96',
                  sizes: '32px',
                  alt: '',
                  class: 'rc-hero-banner__trust-icon-img',
                  width: 32,
                  height: 32
                }}
              {%- else -%}
                <svg class="rc-hero-banner__trust-icon-svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
                  <path d="M12 2 3.5 6v6c0 5.25 3.62 9.52 8.5 10.5 4.88-.98 8.5-5.25 8.5-10.5V6L12 2Z" fill="currentColor" opacity=".18"/>
                  <path d="M12 3.1 4.5 6.55v5.45c0 4.75 3.22 8.6 7.5 9.48 4.28-.88 7.5-4.73 7.5-9.48V6.55L12 3.1Z" stroke="currentColor" stroke-width="1.5"/>
                  <path d="m8.5 12.1 2.5 2.5L16 9.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {%- endif -%}
            </span>
            <div class="rc-hero-banner__trust-body">
              {%- if trust_title != blank -%}
                <p class="rc-hero-banner__trust-title">{{ trust_title | escape }}</p>
              {%- endif -%}
              {%- if trust_subtitle != blank -%}
                <div class="rc-hero-banner__trust-subtitle">{{ trust_subtitle }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        {%- if eyebrow_text != blank -%}
          <p class="rc-hero-banner__eyebrow">{{ eyebrow_text | escape }}</p>
        {%- endif -%}
        {%- if heading_text != blank -%}
          <h2 class="rc-hero-banner__heading">{{ heading_text | escape }}</h2>
        {%- endif -%}
        {%- if subheading_text != blank -%}
          <div class="rc-hero-banner__subheading">{{ subheading_text }}</div>
        {%- endif -%}
      </div>

      {%- if cta_label != blank and cta_link != blank -%}
        <a class="rc-hero-banner__cta" href="{{ cta_link }}">
          <span class="rc-hero-banner__cta-label">{{ cta_label | escape }}</span>
          <svg class="rc-hero-banner__cta-arrow" viewBox="0 0 32 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
            <path d="M1 6h29M25 1l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="rc-hero-banner__circles" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'circle' -%}
              <li class="rc-hero-banner__circle-item" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}
                  <a class="rc-hero-banner__circle-link" href="{{ block.settings.link }}" aria-label="{{ block.settings.alt | escape | default: 'Circle image' }}">
                {%- endif -%}
                <span class="rc-hero-banner__circle">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 320 | image_tag:
                      loading: 'lazy',
                      widths: '96,160,220,320',
                      sizes: 'var(--rc-circle-width, 95px)',
                      alt: block.settings.alt | default: '',
                      class: 'rc-hero-banner__circle-img',
                      width: circle_width,
                      height: circle_height
                    }}
                  {%- else -%}
                    <span class="rc-hero-banner__circle-placeholder" aria-hidden="true"></span>
                  {%- endif -%}
                </span>
                {%- if block.settings.link != blank -%}
                  </a>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{%- comment -%}
  All CSS below is scoped with `.section-rc-hero-banner-{{ section.id }}` (unique per
  section instance) or the shared `.rc-hero-banner` class. Values map 1:1 to Figma
  nodes 1:94612 (Frame 4), 1:94685 (trust badge — Group 14), 1:94714 (Shop Now CTA),
  1:94719 (circle grid — Frame 35).
{%- endcomment -%}

{% stylesheet %}
  .section-rc-hero-banner-{{ section.id }} {
    display: block;
    width: 100%;
    background-color: #0C0D16;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1920 / 880;
    overflow: hidden;
    background-color: #0C0D16;
    isolation: isolate;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__image {
    display: block;
    width: 112.55%;
    height: 123.72%;
    margin-left: -2.65%;
    margin-top: -1.72%;
    object-fit: cover;
    object-position: center center;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__ellipse {
    position: absolute;
    display: block;
    background-color: #333B0C;
    opacity: 0.5;
    filter: blur(100px);
    pointer-events: none;
    border-radius: 50%;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__ellipse--a {
    width: 420px;
    height: 420px;
    top: 8%;
    right: 18%;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__ellipse--b {
    width: 360px;
    height: 360px;
    top: 35%;
    right: -4%;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__scrim {
    position: absolute;
    top: 0;
    left: 0;
    width: 43.77%;
    height: 100%;
    z-index: 1;
    background: linear-gradient(90deg, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0) 100%);
    pointer-events: none;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__content {
    position: absolute;
    top: 13%;
    left: 4.22%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 28px;
    width: 45%;
    max-width: 780px;
    color: #FFFFFF;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__text {
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-items: flex-start;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__trust {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 10px 18px 10px 12px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #FFFFFF;
    max-width: 100%;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__trust-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex: 0 0 32px;
    color: #FFD400;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__trust-icon-img,
  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__trust-icon-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__trust-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__trust-title {
    margin: 0;
    padding: 0;
    font-family: var(--rc-trust-family);
    font-weight: var(--rc-trust-weight);
    font-style: var(--rc-trust-style);
    font-size: clamp(14px, 0.9375vw, 18px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-transform: none;
    color: #FFFFFF;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__trust-subtitle {
    margin: 0;
    padding: 0;
    font-family: var(--rc-body-family);
    font-weight: var(--rc-body-weight);
    font-size: clamp(12px, 0.729vw, 14px);
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.78);
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__trust-subtitle p {
    margin: 0;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__eyebrow {
    margin: 0;
    padding: 0;
    font-family: var(--rc-eyebrow-family);
    font-weight: var(--rc-eyebrow-weight);
    font-style: var(--rc-eyebrow-style);
    font-size: clamp(12px, 0.875vw, 16px);
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: none;
    color: #FFFFFF;
    opacity: 0.8;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__heading {
    margin: 0;
    padding: 0;
    font-family: var(--rc-heading-family);
    font-weight: var(--rc-heading-weight);
    font-style: var(--rc-heading-style);
    font-size: clamp(40px, 4.165vw, 80px);
    line-height: 0.995;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: #FFFFFF;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__subheading {
    margin: 0;
    padding: 0;
    font-family: var(--rc-body-family);
    font-weight: var(--rc-body-weight);
    font-style: var(--rc-body-style);
    font-size: clamp(14px, 0.9375vw, 18px);
    line-height: 1.5;
    color: #FFFFFF;
    opacity: 0.85;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__subheading p {
    margin: 0 0 0.75em 0;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__subheading p:last-child {
    margin-bottom: 0;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-width: 193px;
    padding: 18px 28px;
    background-color: #1A4083;
    color: #FFFFFF;
    border: 0;
    border-radius: 4px;
    text-decoration: none;
    font-family: var(--rc-cta-family);
    font-weight: var(--rc-cta-weight);
    font-style: var(--rc-cta-style);
    font-size: 15px;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease, filter 0.2s ease;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__cta:hover,
  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__cta:focus-visible {
    background-color: #1A4083;
    filter: brightness(1.12);
    transform: translateY(-1px);
    outline: none;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__cta:focus-visible {
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.5);
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__cta-label {
    display: inline-block;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__cta-arrow {
    display: inline-block;
    width: 28px;
    height: 10px;
    flex: 0 0 28px;
    color: currentColor;
    transition: transform 0.2s ease;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__cta:hover .rc-hero-banner__cta-arrow {
    transform: translateX(4px);
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__circles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--rc-circle-gap);
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__circle-item {
    margin: 0;
    padding: 0;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__circle-link {
    display: inline-block;
    text-decoration: none;
    outline: none;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__circle-link:focus-visible .rc-hero-banner__circle {
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.6);
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--rc-circle-width);
    height: var(--rc-circle-height);
    border-radius: 50%;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__circle-link:hover .rc-hero-banner__circle {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__circle-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__circle-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0.02) 100%);
  }

  @media screen and (max-width: 989px) {
    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__content {
      top: 8%;
      left: 5%;
      width: 58%;
      gap: 22px;
    }

    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__scrim {
      width: 60%;
    }

    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__circle {
      width: calc(var(--rc-circle-width) * 0.85);
      height: calc(var(--rc-circle-height) * 0.85);
    }
  }

  @media screen and (max-width: 749px) {
    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__frame {
      aspect-ratio: 4 / 5;
    }

    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__image {
      width: 100%;
      height: 100%;
      margin-left: 0;
      margin-top: 0;
    }

    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__scrim {
      width: 100%;
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.75) 70%, rgba(0, 0, 0, 0.9) 100%);
    }

    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__content {
      position: absolute;
      top: auto;
      bottom: 5%;
      left: 6%;
      right: 6%;
      width: auto;
      gap: 16px;
    }

    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__text {
      gap: 12px;
    }

    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__trust {
      padding: 8px 12px 8px 10px;
      gap: 10px;
    }

    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__trust-icon {
      width: 24px;
      height: 24px;
      flex: 0 0 24px;
    }

    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__trust-title {
      font-size: 13px;
    }

    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__trust-subtitle {
      font-size: 12px;
    }

    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__eyebrow {
      font-size: 12px;
    }

    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__heading {
      font-size: clamp(32px, 8vw, 44px);
    }

    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__subheading {
      font-size: 14px;
    }

    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__cta {
      min-width: 0;
      width: 100%;
      padding: 14px 20px;
      font-size: 14px;
    }

    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__cta-arrow {
      width: 22px;
      flex: 0 0 22px;
    }

    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__circle {
      width: calc(var(--rc-circle-width) * 0.7);
      height: calc(var(--rc-circle-height) * 0.7);
    }

    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__circles {
      gap: calc(var(--rc-circle-gap) * 0.75);
    }

    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__ellipse--a {
      width: 220px;
      height: 220px;
      top: 10%;
      right: -6%;
    }

    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__ellipse--b {
      width: 180px;
      height: 180px;
      top: 40%;
      right: -14%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__cta,
    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__cta-arrow,
    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__circle {
      transition: none;
    }
    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__cta:hover,
    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__cta:focus-visible,
    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__cta:hover .rc-hero-banner__cta-arrow,
    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__circle-link:hover .rc-hero-banner__circle {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero banner (rc)",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Recommended 2161 × 1074 or larger. The image covers the full hero area and bleeds on desktop."
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Image alt text",
      "default": "Ronnie Coleman hero banner"
    },
    {
      "type": "header",
      "content": "Typography",
      "info": "Defaults match the Figma source (Barlow). Swap here if the brand font changes."
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "barlow_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "barlow_n4"
    },
