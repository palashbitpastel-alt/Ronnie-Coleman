{{ 'rc-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign alt_text = section.settings.alt_text | default: 'Ronnie Coleman hero banner'
  assign heading_text = section.settings.heading | default: 'YEAH BUDDY™ BUILT FOR WARRIORS'
  assign eyebrow_text = section.settings.eyebrow | default: 'Ronnie Coleman Signature Series'
  assign subheading_text = section.settings.subheading
  assign cta_label = section.settings.cta_label | default: 'SHOP NOW'
  assign cta_link = section.settings.cta_link | default: '/collections/all'

  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font
  assign eyebrow_font = section.settings.eyebrow_font
  assign cta_font = section.settings.cta_font
-%}

{%- if section.settings.image_height == 'adapt' and section.settings.image != blank -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
      .section-rc-hero-banner-{{ section.id }}.rc-hero-banner--adapt .rc-hero-banner__media::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
    @media screen and (min-width: 750px) {
      .section-rc-hero-banner-{{ section.id }}.rc-hero-banner--adapt .rc-hero-banner__media::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{%- style -%}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ eyebrow_font | font_face: font_display: 'swap' }}
  {{ cta_font | font_face: font_display: 'swap' }}

  .section-rc-hero-banner-{{ section.id }} {
    --rc-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --rc-heading-weight: {{ heading_font.weight }};
    --rc-heading-style: {{ heading_font.style }};
    --rc-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    --rc-body-weight: {{ body_font.weight }};
    --rc-body-style: {{ body_font.style }};
    --rc-eyebrow-family: {{ eyebrow_font.family }}, {{ eyebrow_font.fallback_families }};
    --rc-eyebrow-weight: {{ eyebrow_font.weight }};
    --rc-eyebrow-style: {{ eyebrow_font.style }};
    --rc-cta-family: {{ cta_font.family }}, {{ cta_font.fallback_families }};
    --rc-cta-weight: {{ cta_font.weight }};
    --rc-cta-style: {{ cta_font.style }};
    {%- if section.settings.shadow_enabled -%}
      --rc-hero-shadow: 0 {{ section.settings.shadow_y }}px {{ section.settings.shadow_blur }}px rgba(0, 0, 0, {{ section.settings.shadow_opacity | divided_by: 100.0 }});
    {%- else -%}
      --rc-hero-shadow: none;
    {%- endif -%}
  }
  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__scrim {
    opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
  }
{%- endstyle -%}

<section class="section-rc-hero-banner-{{ section.id }} rc-hero-banner rc-hero-banner--h-{{ section.settings.image_height }} rc-hero-banner--content-position-{{ section.settings.desktop_content_position }} rc-hero-banner--align-{{ section.settings.desktop_content_alignment }} rc-hero-banner--mobile-align-{{ section.settings.mobile_content_alignment }}{% if section.settings.show_text_box == false %} rc-hero-banner--desktop-transparent{% endif %}{% if section.settings.show_text_below %} rc-hero-banner--mobile-bottom{% endif %}{% if section.settings.stack_images_on_mobile and section.settings.image != blank and section.settings.image_2 != blank %} rc-hero-banner--stacked{% endif %}{% if section.settings.image_height == 'adapt' and section.settings.image != blank %} rc-hero-banner--adapt{% endif %}">
  <div class="rc-hero-banner__frame">
    <div class="rc-hero-banner__media{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 3840 | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '480,768,1024,1440,1920,2560,3200,3840',
          sizes: '(min-width: 750px) 100vw, 100vw',
          alt: alt_text,
          class: 'rc-hero-banner__image{% if section.settings.image_2 != blank %} rc-hero-banner__image--half{% endif %}',
          width: section.settings.image.width,
          height: section.settings.image.height
        }}
      {%- endif -%}
      {%- if section.settings.image_2 != blank -%}
        {{ section.settings.image_2 | image_url: width: 3840 | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '480,768,1024,1440,1920,2560,3200,3840',
          sizes: '(min-width: 750px) 50vw, 100vw',
          alt: alt_text,
          class: 'rc-hero-banner__image rc-hero-banner__image--half',
          width: section.settings.image_2.width,
          height: section.settings.image_2.height
        }}
      {%- endif -%}

      <span class="rc-hero-banner__ellipse rc-hero-banner__ellipse--a" aria-hidden="true"></span>
      <span class="rc-hero-banner__ellipse rc-hero-banner__ellipse--b" aria-hidden="true"></span>
    </div>

    <div class="rc-hero-banner__scrim" aria-hidden="true"></div>
    <div class="page-width rc-hero-banner__wrapper">
    <div class="rc-hero-banner__content color-{{ section.settings.color_scheme }} gradient">
      <div class="rc-hero-banner__text">
        {%- if eyebrow_text != blank -%}
          <p class="rc-hero-banner__eyebrow">
            {%- if section.settings.show_eyebrow_icon -%}
              <span class="rc-hero-banner__eyebrow-icon" aria-hidden="true">
                {{- 'rc-hero-eyebrow-icon.svg' | inline_asset_content -}}
              </span>
            {%- endif -%}
            <span class="rc-hero-banner__eyebrow-text">{{ eyebrow_text | escape }}</span>
          </p>
        {%- endif -%}
        {%- if heading_text != blank -%}
          <h2 class="rc-hero-banner__heading">{{ heading_text | escape }}</h2>
        {%- endif -%}
        {%- if subheading_text != blank -%}
          <div class="rc-hero-banner__subheading">{{ subheading_text }}</div>
        {%- endif -%}
      </div>

      {%- if cta_label != blank and cta_link != blank -%}
        <a class="rc-hero-banner__cta" href="{{ cta_link }}">
          <span class="rc-hero-banner__cta-label">{{ cta_label | escape }}</span>
          {%- if section.settings.show_cta_icon -%}
            <span class="rc-hero-banner__cta-icon" aria-hidden="true">
              {{- 'rc-hero-arrow-right.svg' | inline_asset_content -}}
            </span>
          {%- endif -%}
        </a>
      {%- endif -%}
    </div>
    </div>
  </div>
</section>

{%- comment -%}
  All CSS below is scoped with `.section-rc-hero-banner-{{ section.id }}` (unique per
  section instance) or the shared `.rc-hero-banner` class. Values map 1:1 to Figma
  node 1:94612 (Frame 4 of the Home Page).
{%- endcomment -%}

{% schema %}
{
  "name": "Hero banner (rc)",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Recommended 2161 × 1074 or larger. The image covers the full hero area and bleeds on desktop."
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Image alt text",
      "default": "Ronnie Coleman hero banner"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Second image"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Image overlay opacity",
      "default": 0
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        { "value": "adapt", "label": "Adapt to first image" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium",
      "label": "Banner height",
      "info": "For best results, use an image with a 16:9 aspect ratio."
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "middle-center",
      "label": "Desktop content position"
    },
    {
      "type": "checkbox",
      "id": "show_text_box",
      "default": true,
      "label": "Show container on desktop"
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "label": "Desktop content alignment"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "image_behavior",
      "options": [
        { "value": "none", "label": "No animation" },
        { "value": "ambient", "label": "Ambient movement" },
        { "value": "fixed", "label": "Fixed background position" },
        { "value": "zoom-in", "label": "Zoom in on scroll" }
      ],
      "default": "none",
      "label": "Image behavior"
    },
    {
      "type": "header",
      "content": "Typography",
      "info": "Defaults match the Figma source (Barlow). Swap here if the brand font changes."
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "barlow_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "barlow_n4"
    },
    {
      "type": "font_picker",
      "id": "eyebrow_font",
      "label": "Eyebrow font",
      "default": "barlow_n4"
    },
    {
      "type": "font_picker",
      "id": "cta_font",
      "label": "Button font",
      "default": "barlow_n7"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Trusted by Millions of Athletes Worldwide."
    },
    {
      "type": "checkbox",
      "id": "show_eyebrow_icon",
      "label": "Show trust icon before eyebrow",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "YEAH BUDDY™ BUILT FOR WARRIORS"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Elite nutrition formulated by the 8-time Mr. Olympia. No shortcuts. No compromises.</p>"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "show_cta_icon",
      "label": "Show arrow icon after button label",
      "default": true
    },
    {
      "type": "header",
      "content": "Drop shadow"
    },
    {
      "type": "checkbox",
      "id": "shadow_enabled",
      "label": "Enable drop shadow",
      "default": true
    },
    {
      "type": "range",
      "id": "shadow_y",
      "label": "Shadow Y offset",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "shadow_blur",
      "label": "Shadow blur",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "shadow_opacity",
      "label": "Shadow opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "label": "Mobile content alignment"
    },
    {
      "type": "checkbox",
      "id": "stack_images_on_mobile",
      "default": true,
      "label": "Stack images on mobile"
    },
    {
      "type": "checkbox",
      "id": "show_text_below",
      "default": true,
      "label": "Show container on mobile"
    }
  ],
  "presets": [
    {
      "name": "Hero banner (rc)",
      "category": "Image",
      "settings": {
        "alt_text": "Ronnie Coleman hero banner",
        "eyebrow": "Trusted by Millions of Athletes Worldwide.",
        "show_eyebrow_icon": true,
        "heading": "BUILT TO INSPIRE. MADE TO PERFORM.",
        "subheading": "<p>Scientifically formulated supplements designed by 8× Mr. Olympia Ronnie Coleman to help you build muscle, recover faster, and dominate every workout.</p>",
        "cta_label": "SHOP NOW",
        "show_cta_icon": true
      }
    }
  ]
}
{% endschema %}
