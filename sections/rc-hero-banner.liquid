{%- comment -%}
  RC Hero Banner
  Full-width hero banner for Ronnie Coleman Signature Series homepage.
  Fonts: Helvetica Neue (headline), Barlow (body/eyebrow), Manderley (CTA button).
  Manderley is a display font; if unavailable, Dancing Script is used as a visual fallback.
  Google Fonts: https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Dancing+Script:wght@400&display=swap
{%- endcomment -%}

{%- style -%}
  .rc-hero-banner-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: 55rem; /* 880px */
    height: 55rem;
    overflow: hidden;
    display: flex;
    align-items: center;
    background-color: #0C0D16;
    color: #FFFFFF;
  }

  .rc-hero-banner-{{ section.id }} .rc-hero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .rc-hero-banner-{{ section.id }} .rc-hero__media img,
  .rc-hero-banner-{{ section.id }} .rc-hero__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
    display: block;
  }

  .rc-hero-banner-{{ section.id }} .rc-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 100%);
    z-index: 1;
  }

  .rc-hero-banner-{{ section.id }} .rc-hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 0 5rem;
    display: flex;
    align-items: center;
  }

  .rc-hero-banner-{{ section.id }} .rc-hero__content {
    max-width: 35.625rem; /* 570px */
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .rc-hero-banner-{{ section.id }} .rc-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: "Barlow", sans-serif;
    font-weight: 400;
    font-size: 1.5rem; /* 24px */
    line-height: 1.5;
    color: #FFFFFF;
    margin: 0;
  }

  .rc-hero-banner-{{ section.id }} .rc-hero__eyebrow-star {
    color: #EED427;
    font-size: 1.25rem;
    line-height: 1;
  }

  .rc-hero-banner-{{ section.id }} .rc-hero__heading {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-weight: 700;
    font-size: 4.0625rem; /* 65px */
    line-height: 0.995;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: #FFFFFF;
    margin: 0;
  }

  .rc-hero-banner-{{ section.id }} .rc-hero__subtext {
    font-family: "Barlow", sans-serif;
    font-weight: 400;
    font-size: 1.5rem; /* 24px */
    line-height: 1.5;
    color: #FFFFFF;
    margin: 0;
  }

  .rc-hero-banner-{{ section.id }} .rc-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    align-self: flex-start;
    margin-top: 0.5rem;
    padding: 1rem 2rem;
    background-color: #EED427;
    color: #0C0D16;
    border-radius: 999px;
    border: none;
    text-decoration: none;
    font-family: "Manderley", "Dancing Script", cursive;
    font-weight: 400;
    font-size: 1.125rem; /* 18px */
    line-height: 1;
    transition: transform 0.2s ease, background-color 0.2s ease;
    cursor: pointer;
  }

  .rc-hero-banner-{{ section.id }} .rc-hero__cta:hover {
    background-color: #FFE24A;
    transform: translateY(-2px);
  }

  .rc-hero-banner-{{ section.id }} .rc-hero__cta-arrow {
    display: inline-flex;
    width: 1.125rem;
    height: 1.125rem;
  }

  .rc-hero-banner-{{ section.id }} .rc-hero__cta-arrow svg {
    width: 100%;
    height: 100%;
    stroke: #0C0D16;
    fill: none;
  }

  @media screen and (max-width: 989px) {
    .rc-hero-banner-{{ section.id }} {
      min-height: 40rem;
      height: auto;
      padding: 4rem 0;
    }

    .rc-hero-banner-{{ section.id }} .rc-hero__inner {
      padding: 0 2rem;
    }

    .rc-hero-banner-{{ section.id }} .rc-hero__heading {
      font-size: 3rem;
    }
  }

  @media screen and (max-width: 749px) {
    .rc-hero-banner-{{ section.id }} {
      min-height: 32rem;
      padding: 3rem 0;
    }

    .rc-hero-banner-{{ section.id }} .rc-hero__inner {
      padding: 0 1.25rem;
    }

    .rc-hero-banner-{{ section.id }} .rc-hero__content {
      max-width: 100%;
      gap: 1rem;
    }

    .rc-hero-banner-{{ section.id }} .rc-hero__eyebrow {
      font-size: 1rem;
    }

    .rc-hero-banner-{{ section.id }} .rc-hero__heading {
      font-size: 2.5rem; /* 40px */
      line-height: 1;
    }

    .rc-hero-banner-{{ section.id }} .rc-hero__subtext {
      font-size: 1rem;
    }

    .rc-hero-banner-{{ section.id }} .rc-hero__cta {
      padding: 0.875rem 1.5rem;
      font-size: 1rem;
    }
  }
{%- endstyle -%}

<section
  class="rc-hero-banner rc-hero-banner-{{ section.id }}"
  aria-label="{{ section.settings.heading | default: 'Hero banner' | escape }}"
>
  <div class="rc-hero__media">
    {%- if section.settings.background_image != blank -%}
      {{
        section.settings.background_image
        | image_url: width: 1920
        | image_tag:
          loading: 'lazy',
          widths: '750, 1100, 1500, 1920, 2400',
          sizes: '100vw',
          alt: section.settings.heading | default: 'Ronnie Coleman hero'
      }}
    {%- endif -%}
  </div>

  <div class="rc-hero__overlay" aria-hidden="true"></div>

  <div class="rc-hero__inner">
    <div class="rc-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="rc-hero__eyebrow">
          <span class="rc-hero__eyebrow-star" aria-hidden="true">&#9733;</span>
          <span>{{ section.settings.eyebrow | escape }}</span>
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="rc-hero__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}

      {%- if section.settings.subtext != blank -%}
        <p class="rc-hero__subtext">{{ section.settings.subtext | escape }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          class="rc-hero__cta"
          href="{{ section.settings.button_link | default: '#' }}"
          aria-label="{{ section.settings.button_label | escape }}"
        >
          <span>{{ section.settings.button_label | escape }}</span>
          <span class="rc-hero__cta-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="4" y1="12" x2="20" y2="12"></line>
              <polyline points="13 5 20 12 13 19"></polyline>
            </svg>
          </span>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RC Hero Banner",
  "tag": "section",
  "class": "section rc-hero-banner-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Trusted by Millions of Athletes Worldwide."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "BUILT TO INSPIRE. MADE TO PERFORM."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Scientifically formulated supplements designed by 8× Mr. Olympia Ronnie Coleman to fuel your training, recovery, and results."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "RC Hero Banner"
    }
  ]
}
{% endschema %}
