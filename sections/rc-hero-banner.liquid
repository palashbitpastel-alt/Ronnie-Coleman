{%- liquid
  assign heading_size = section.settings.heading_size | default: 5
  assign alignment = section.settings.content_alignment | default: 'middle-center'
  assign alt_text = section.settings.alt_text | default: 'Ronnie Coleman hero banner'
  assign scrim_opacity = section.settings.overlay_opacity | times: 1.0 | divided_by: 100.0
  assign mobile_aspect = section.settings.mobile_aspect | default: '4:5'
-%}

<section class="section-rc-hero-banner-{{ section.id }} rc-hero-banner rc-hero-banner--align-{{ alignment }} rc-hero-banner--mobile-{{ mobile_aspect | replace: ':', '-' }}{% if section.settings.desktop_full_width %} rc-hero-banner--full-width{% endif %}">
  <div class="rc-hero-banner__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 3840 | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        widths: '480,768,1024,1440,1920,2560,3200,3840',
        sizes: '100vw',
        alt: alt_text,
        class: 'rc-hero-banner__image',
        width: section.settings.image.width,
        height: section.settings.image.height
      }}
    {%- else -%}
      <div class="rc-hero-banner__placeholder" role="img" aria-label="{{ alt_text | escape }}">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg rc-hero-banner__placeholder-svg' }}
      </div>
    {%- endif -%}

    {%- if section.settings.show_overlay and section.settings.overlay_opacity > 0 -%}
      <div class="rc-hero-banner__scrim" style="opacity: {{ scrim_opacity }};"></div>
    {%- endif -%}

    {%- if section.settings.show_overlay -%}
      <div
        class="rc-hero-banner__overlay"
        style="color: {{ section.settings.text_color }};"
      >
        <div class="rc-hero-banner__content rc-hero-banner__content--size-{{ heading_size }}">
          {%- if section.settings.eyebrow != blank -%}
            <p class="rc-hero-banner__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="rc-hero-banner__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <div class="rc-hero-banner__subheading">{{ section.settings.subheading }}</div>
          {%- endif -%}
          {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
            <a
              class="rc-hero-banner__cta"
              href="{{ section.settings.cta_link }}"
              style="background-color: {{ section.settings.cta_bg_color }}; color: {{ section.settings.cta_text_color }};"
            >
              {{ section.settings.cta_label | escape }}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{%- comment -%}
  All CSS below is scoped with `.section-rc-hero-banner-{{ section.id }}` (unique per section instance)
  or the shared `.rc-hero-banner` class to prevent style leakage into other sections.
{%- endcomment -%}

{% stylesheet %}
  .section-rc-hero-banner-{{ section.id }}.rc-hero-banner {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    position: relative;
    overflow: hidden;
    background-color: #000;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__media {
    position: relative;
    width: 100%;
    aspect-ratio: 2161 / 1074;
    overflow: hidden;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #0b0b0b;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__scrim {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 1);
    pointer-events: none;
    z-index: 1;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__overlay {
    position: absolute;
    inset: 0;
    display: grid;
    padding: clamp(1.5rem, 5vw, 5rem);
    z-index: 2;
    pointer-events: none;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__content {
    max-width: 44rem;
    pointer-events: auto;
    font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif;
  }

  .section-rc-hero-banner-{{ section.id }}.rc-hero-banner--align-top-left .rc-hero-banner__overlay { place-items: start start; }
  .section-rc-hero-banner-{{ section.id }}.rc-hero-banner--align-top-center .rc-hero-banner__overlay { place-items: start center; text-align: center; }
  .section-rc-hero-banner-{{ section.id }}.rc-hero-banner--align-top-right .rc-hero-banner__overlay { place-items: start end; text-align: right; }
  .section-rc-hero-banner-{{ section.id }}.rc-hero-banner--align-middle-left .rc-hero-banner__overlay { place-items: center start; }
  .section-rc-hero-banner-{{ section.id }}.rc-hero-banner--align-middle-center .rc-hero-banner__overlay { place-items: center center; text-align: center; }
  .section-rc-hero-banner-{{ section.id }}.rc-hero-banner--align-middle-right .rc-hero-banner__overlay { place-items: center end; text-align: right; }
  .section-rc-hero-banner-{{ section.id }}.rc-hero-banner--align-bottom-left .rc-hero-banner__overlay { place-items: end start; }
  .section-rc-hero-banner-{{ section.id }}.rc-hero-banner--align-bottom-center .rc-hero-banner__overlay { place-items: end center; text-align: center; }
  .section-rc-hero-banner-{{ section.id }}.rc-hero-banner--align-bottom-right .rc-hero-banner__overlay { place-items: end end; text-align: right; }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin: 0 0 0.75rem 0;
    opacity: 0.9;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__heading {
    margin: 0 0 1rem 0;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__content--size-1 .rc-hero-banner__heading { font-size: clamp(1.5rem, 3vw, 2rem); }
  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__content--size-2 .rc-hero-banner__heading { font-size: clamp(1.75rem, 3.5vw, 2.5rem); }
  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__content--size-3 .rc-hero-banner__heading { font-size: clamp(2rem, 4vw, 3rem); }
  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__content--size-4 .rc-hero-banner__heading { font-size: clamp(2.25rem, 4.5vw, 3.5rem); }
  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__content--size-5 .rc-hero-banner__heading { font-size: clamp(2.5rem, 5vw, 4rem); }
  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__content--size-6 .rc-hero-banner__heading { font-size: clamp(2.75rem, 5.5vw, 4.5rem); }
  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__content--size-7 .rc-hero-banner__heading { font-size: clamp(3rem, 6vw, 5rem); }
  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__content--size-8 .rc-hero-banner__heading { font-size: clamp(3.25rem, 7vw, 6rem); }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__subheading {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.5;
    margin: 0 0 1.5rem 0;
    font-weight: 400;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__subheading > * {
    margin: 0 0 0.5rem 0;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 1.75rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 0.2s ease, filter 0.2s ease;
    font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif;
    cursor: pointer;
    border: 0;
  }

  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__cta:hover,
  .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__cta:focus-visible {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }

  @media screen and (max-width: 749px) {
    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__media {
      aspect-ratio: 4 / 5;
      min-height: 60vh;
    }

    .section-rc-hero-banner-{{ section.id }}.rc-hero-banner--mobile-1-1 .rc-hero-banner__media {
      aspect-ratio: 1 / 1;
    }

    .section-rc-hero-banner-{{ section.id }}.rc-hero-banner--mobile-16-9 .rc-hero-banner__media {
      aspect-ratio: 16 / 9;
      min-height: 0;
    }

    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__image {
      object-fit: cover;
      object-position: center;
    }

    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__overlay {
      padding: clamp(1rem, 6vw, 2rem);
    }

    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__eyebrow {
      font-size: 0.6875rem;
    }

    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__content--size-1 .rc-hero-banner__heading { font-size: clamp(1.25rem, 6vw, 1.625rem); }
    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__content--size-2 .rc-hero-banner__heading { font-size: clamp(1.375rem, 6.5vw, 2rem); }
    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__content--size-3 .rc-hero-banner__heading { font-size: clamp(1.625rem, 7vw, 2.375rem); }
    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__content--size-4 .rc-hero-banner__heading { font-size: clamp(1.75rem, 7.5vw, 2.75rem); }
    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__content--size-5 .rc-hero-banner__heading { font-size: clamp(2rem, 8vw, 3.25rem); }
    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__content--size-6 .rc-hero-banner__heading { font-size: clamp(2.25rem, 8.5vw, 3.625rem); }
    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__content--size-7 .rc-hero-banner__heading { font-size: clamp(2.5rem, 9vw, 4rem); }
    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__content--size-8 .rc-hero-banner__heading { font-size: clamp(2.625rem, 10vw, 4.75rem); }

    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__subheading {
      font-size: 0.9375rem;
    }

    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__cta {
      padding: 0.75rem 1.25rem;
      font-size: 0.8125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__cta {
      transition: none;
    }

    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__cta:hover,
    .section-rc-hero-banner-{{ section.id }} .rc-hero-banner__cta:focus-visible {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero banner (rc)",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Image alt text",
      "default": "Ronnie Coleman hero banner",
      "info": "Describe the image for accessibility and SEO."
    },
    {
      "type": "checkbox",
      "id": "desktop_full_width",
      "label": "Full width on desktop",
      "default": true
    },
    {
      "type": "select",
      "id": "mobile_aspect",
      "label": "Mobile aspect ratio",
      "options": [
        { "value": "4:5", "label": "4 : 5 (portrait)" },
        { "value": "1:1", "label": "1 : 1 (square)" },
        { "value": "16:9", "label": "16 : 9 (landscape)" }
      ],
      "default": "4:5"
    },
    {
      "type": "header",
      "content": "Overlay content"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show text overlay",
      "default": false,
      "info": "Keep off to match the Figma image exactly."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 5
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "middle-center"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "cta_bg_color",
      "label": "Button background",
      "default": "#ffd400"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Button text",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image darken amount",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Hero banner (rc)",
      "category": "Image"
    }
  ]
}
{% endschema %}
