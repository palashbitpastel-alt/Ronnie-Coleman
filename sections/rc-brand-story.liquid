{%- liquid
  assign eyebrow_text = section.settings.eyebrow
  assign heading_text = section.settings.heading
  assign quote_text = section.settings.quote
  assign attribution_text = section.settings.attribution
  assign body_text = section.settings.body
  assign cta_label = section.settings.cta_label
  assign cta_link = section.settings.cta_link
  assign image_position = section.settings.image_position
  assign quote_alignment = section.settings.quote_alignment
  assign content_alignment = section.settings.content_alignment
  assign show_hero_quote = section.settings.show_hero_quote
  assign show_split = section.settings.show_split

  assign heading_font = section.settings.heading_font
  assign quote_font = section.settings.quote_font
  assign body_font = section.settings.body_font
  assign cta_font = section.settings.cta_font
-%}

{%- style -%}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ quote_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ cta_font | font_face: font_display: 'swap' }}

  .section-rc-brand-story-{{ section.id }} {
    --rc-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --rc-heading-weight: {{ heading_font.weight }};
    --rc-heading-style: {{ heading_font.style }};
    --rc-quote-family: {{ quote_font.family }}, {{ quote_font.fallback_families }};
    --rc-quote-weight: {{ quote_font.weight }};
    --rc-quote-style: {{ quote_font.style }};
    --rc-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    --rc-body-weight: {{ body_font.weight }};
    --rc-body-style: {{ body_font.style }};
    --rc-cta-family: {{ cta_font.family }}, {{ cta_font.fallback_families }};
    --rc-cta-weight: {{ cta_font.weight }};
    --rc-cta-style: {{ cta_font.style }};
    --rc-bg: {{ section.settings.background_color }};
    --rc-text-color: {{ section.settings.text_color }};
    --rc-heading-color: {{ section.settings.heading_color }};
    --rc-quote-color: {{ section.settings.quote_color }};
    --rc-accent-color: {{ section.settings.accent_color }};
    --rc-cta-bg: {{ section.settings.cta_background }};
    --rc-cta-text: {{ section.settings.cta_text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="section-rc-brand-story-{{ section.id }} rc-brand-story rc-brand-story--image-{{ image_position }} rc-brand-story--quote-{{ quote_alignment }} rc-brand-story--content-{{ content_alignment }}">
  <div class="page-width rc-brand-story__inner">
    {%- if show_hero_quote and quote_text != blank -%}
      <figure class="rc-brand-story__hero-quote">
        <svg class="rc-brand-story__quote-mark rc-brand-story__quote-mark--open" viewBox="0 0 48 36" width="48" height="36" aria-hidden="true" focusable="false">
          <path d="M0 36V21.6C0 10.08 6 2.88 19.2 0l2.4 6c-7.2 2.4-10.8 6.72-10.8 12.72h10.8V36H0zm26.4 0V21.6C26.4 10.08 32.4 2.88 45.6 0L48 6c-7.2 2.4-10.8 6.72-10.8 12.72H48V36H26.4z" fill="currentColor"/>
        </svg>
        <blockquote class="rc-brand-story__quote">{{ quote_text }}</blockquote>
        {%- if attribution_text != blank -%}
          <figcaption class="rc-brand-story__attribution">— {{ attribution_text | escape }}</figcaption>
        {%- endif -%}
      </figure>
    {%- endif -%}

    {%- if show_split -%}
    <div class="rc-brand-story__split">
      <div class="rc-brand-story__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1600 | image_tag:
            loading: 'lazy',
            widths: '400,600,800,1000,1200,1600',
            sizes: '(min-width: 990px) 50vw, 100vw',
            alt: heading_text,
            class: 'rc-brand-story__image'
          }}
        {%- endif -%}
        {%- if section.settings.video_url != blank -%}
          <a href="{{ section.settings.video_url }}" class="rc-brand-story__play" aria-label="Play video">
            <svg viewBox="0 0 64 64" width="64" height="64" aria-hidden="true" focusable="false">
              <circle cx="32" cy="32" r="30" fill="rgba(255,255,255,0.92)"/>
              <path d="M26 20l20 12-20 12V20z" fill="#0C0D16"/>
            </svg>
          </a>
        {%- endif -%}
      </div>

      <div class="rc-brand-story__content">
        {%- if eyebrow_text != blank -%}
          <p class="rc-brand-story__eyebrow">{{ eyebrow_text | escape }}</p>
        {%- endif -%}
        {%- if heading_text != blank -%}
          <h2 class="rc-brand-story__heading">{{ heading_text | escape }}</h2>
        {%- endif -%}
        {%- if body_text != blank -%}
          <div class="rc-brand-story__body">{{ body_text }}</div>
        {%- endif -%}
        {%- if cta_label != blank -%}
          <a class="rc-brand-story__cta" href="{{ cta_link | default: '#' }}">
            <span>{{ cta_label | escape }}</span>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path d="M5 12h14M13 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .section-rc-brand-story-{{ section.id }} {
    display: block;
    width: 100%;
    background-color: var(--rc-bg, #FFFFFF);
  }

  .section-rc-brand-story-{{ section.id }} .rc-brand-story__inner {
    display: flex;
    flex-direction: column;
    gap: 72px;
  }

  .section-rc-brand-story-{{ section.id }} .rc-brand-story__hero-quote {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 1100px;
  }

  .section-rc-brand-story--quote-left .rc-brand-story__hero-quote { align-self: flex-start; text-align: left; align-items: flex-start; }
  .section-rc-brand-story--quote-center .rc-brand-story__hero-quote { align-self: center; text-align: center; align-items: center; }
  .section-rc-brand-story--quote-right .rc-brand-story__hero-quote { align-self: flex-end; text-align: right; align-items: flex-end; }

  .section-rc-brand-story-{{ section.id }} .rc-brand-story__quote-mark {
    color: var(--rc-accent-color, #1A4083);
    opacity: 0.4;
    align-self: center;
  }

  .section-rc-brand-story-{{ section.id }} .rc-brand-story__quote {
    margin: 0;
    font-family: var(--rc-quote-family);
    font-weight: var(--rc-quote-weight);
    font-style: italic;
    font-size: clamp(28px, 3.125vw, 48px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--rc-quote-color, #222222);
  }

  .section-rc-brand-story-{{ section.id }} .rc-brand-story__attribution {
    margin: 0;
    font-family: var(--rc-body-family);
    font-weight: var(--rc-body-weight);
    font-style: var(--rc-body-style);
    font-size: clamp(14px, 1.05vw, 18px);
    line-height: 1.4;
    color: var(--rc-text-color, #222222);
    opacity: 0.7;
  }

  .section-rc-brand-story-{{ section.id }} .rc-brand-story__split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .section-rc-brand-story--image-right .rc-brand-story__split {
    grid-template-areas: "content media";
  }
  .section-rc-brand-story--image-right .rc-brand-story__media { grid-area: media; }
  .section-rc-brand-story--image-right .rc-brand-story__content { grid-area: content; }

  .section-rc-brand-story--image-left .rc-brand-story__split {
    grid-template-areas: "media content";
  }
  .section-rc-brand-story--image-left .rc-brand-story__media { grid-area: media; }
  .section-rc-brand-story--image-left .rc-brand-story__content { grid-area: content; }

  .section-rc-brand-story-{{ section.id }} .rc-brand-story__media {
    position: relative;
    width: 100%;
    aspect-ratio: 5 / 4;
    border-radius: 16px;
    overflow: hidden;
    background-color: #EEF1F6;
  }

  .section-rc-brand-story-{{ section.id }} .rc-brand-story__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .section-rc-brand-story-{{ section.id }} .rc-brand-story__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: inline-flex;
    transition: transform 0.25s ease;
  }

  .section-rc-brand-story-{{ section.id }} .rc-brand-story__play:hover,
  .section-rc-brand-story-{{ section.id }} .rc-brand-story__play:focus-visible {
    transform: translate(-50%, -50%) scale(1.06);
    outline: none;
  }

  .section-rc-brand-story-{{ section.id }} .rc-brand-story__content {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 560px;
  }

  .section-rc-brand-story--content-left .rc-brand-story__content { text-align: left; align-items: flex-start; }
  .section-rc-brand-story--content-center .rc-brand-story__content { text-align: center; align-items: center; }
  .section-rc-brand-story--content-right .rc-brand-story__content { text-align: right; align-items: flex-end; }

  .section-rc-brand-story-{{ section.id }} .rc-brand-story__eyebrow {
    margin: 0;
    font-family: var(--rc-body-family);
    font-weight: var(--rc-body-weight);
    font-style: var(--rc-body-style);
    font-size: 14px;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rc-accent-color, #1A4083);
  }

  .section-rc-brand-story-{{ section.id }} .rc-brand-story__heading {
    margin: 0;
    font-family: var(--rc-heading-family);
    font-weight: var(--rc-heading-weight);
    font-style: var(--rc-heading-style);
    font-size: clamp(26px, 2.43vw, 35px);
    line-height: 1.12;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--rc-heading-color, #222222);
  }

  .section-rc-brand-story-{{ section.id }} .rc-brand-story__body {
    font-family: var(--rc-body-family);
    font-weight: var(--rc-body-weight);
    font-style: var(--rc-body-style);
    font-size: clamp(14px, 1.05vw, 18px);
    line-height: 1.6;
    color: var(--rc-text-color, #222222);
  }

  .section-rc-brand-story-{{ section.id }} .rc-brand-story__body p {
    margin: 0 0 0.75em 0;
  }

  .section-rc-brand-story-{{ section.id }} .rc-brand-story__body p:last-child {
    margin-bottom: 0;
  }

  .section-rc-brand-story-{{ section.id }} .rc-brand-story__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: max-content;
    padding: 16px 28px;
    margin-top: 8px;
    background-color: var(--rc-cta-bg, #1A4083);
    color: var(--rc-cta-text, #FFFFFF);
    border-radius: 4px;
    text-decoration: none;
    font-family: var(--rc-cta-family);
    font-weight: var(--rc-cta-weight);
    font-style: var(--rc-cta-style);
    font-size: 14px;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: filter 0.2s ease, transform 0.2s ease;
  }

  .section-rc-brand-story-{{ section.id }} .rc-brand-story__cta:hover,
  .section-rc-brand-story-{{ section.id }} .rc-brand-story__cta:focus-visible {
    filter: brightness(1.12);
    transform: translateY(-1px);
    outline: none;
  }

  @media screen and (max-width: 989px) {
    .section-rc-brand-story-{{ section.id }} .rc-brand-story__inner {
      gap: 48px;
    }
    .section-rc-brand-story-{{ section.id }} .rc-brand-story__split {
      grid-template-columns: 1fr !important;
      grid-template-areas: "media" "content" !important;
      gap: 32px;
    }
  }

  @media screen and (max-width: 749px) {
    .section-rc-brand-story-{{ section.id }} .rc-brand-story__cta {
      width: 100%;
      justify-content: center;
      padding: 14px 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-rc-brand-story-{{ section.id }} .rc-brand-story__cta,
    .section-rc-brand-story-{{ section.id }} .rc-brand-story__play {
      transition: none;
    }
    .section-rc-brand-story-{{ section.id }} .rc-brand-story__cta:hover,
    .section-rc-brand-story-{{ section.id }} .rc-brand-story__play:hover {
      transform: translate(-50%, -50%);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand story (rc)",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Hero quote"
    },
    {
      "type": "checkbox",
      "id": "show_hero_quote",
      "label": "Show hero quote",
      "default": true
    },
    {
      "type": "richtext",
      "id": "quote",
      "label": "Large italic quote",
      "default": "<p>Everybody wants to be a bodybuilder, but nobody wants to lift no heavy-ass weights.</p>"
    },
    {
      "type": "text",
      "id": "attribution",
      "label": "Attribution",
      "default": "Ronnie Coleman"
    },
    {
      "type": "select",
      "id": "quote_alignment",
      "label": "Quote alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Story split"
    },
    {
      "type": "checkbox",
      "id": "show_split",
      "label": "Show image + text split",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Story image"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video link (optional)",
      "info": "Adds a play button that opens this URL."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Ronnie Coleman Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why I created Ronnie Coleman Signature Series"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>From a regimen built on discipline, sweat, and heavy iron — to a line of supplements designed for everyone who refuses to cut corners. This is the real story behind the legend.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "READ THE STORY"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "helvetica_n7"
    },
    {
      "type": "font_picker",
      "id": "quote_font",
      "label": "Quote font",
      "default": "helvetica_n4i"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "barlow_n4"
    },
    {
      "type": "font_picker",
      "id": "cta_font",
      "label": "Button font",
      "default": "helvetica_n7"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote color",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#1A4083"
    },
    {
      "type": "color",
      "id": "cta_background",
      "label": "Button background",
      "default": "#1A4083"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Brand story (rc)",
      "category": "Text",
      "settings": {
        "quote": "<p>Everybody wants to be a bodybuilder, but nobody wants to lift no heavy-ass weights.</p>",
        "attribution": "Ronnie Coleman",
        "eyebrow": "The Ronnie Coleman Story",
        "heading": "Why I created Ronnie Coleman Signature Series"
      }
    }
  ]
}
{% endschema %}
