{%- liquid
  assign eyebrow_text = section.settings.eyebrow
  assign heading_text = section.settings.heading
  assign body_text = section.settings.body
  assign cta_label = section.settings.cta_label
  assign cta_link = section.settings.cta_link
  assign app_store_link = section.settings.app_store_link
  assign google_play_link = section.settings.google_play_link
  assign media_position = section.settings.media_position

  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font
  assign cta_font = section.settings.cta_font
-%}

{%- style -%}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ cta_font | font_face: font_display: 'swap' }}

  .section-rc-app-promo-{{ section.id }} {
    --rc-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --rc-heading-weight: {{ heading_font.weight }};
    --rc-heading-style: {{ heading_font.style }};
    --rc-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    --rc-body-weight: {{ body_font.weight }};
    --rc-body-style: {{ body_font.style }};
    --rc-cta-family: {{ cta_font.family }}, {{ cta_font.fallback_families }};
    --rc-cta-weight: {{ cta_font.weight }};
    --rc-cta-style: {{ cta_font.style }};
    --rc-bg: {{ section.settings.background_color }};
    --rc-heading-color: {{ section.settings.heading_color }};
    --rc-text-color: {{ section.settings.text_color }};
    --rc-accent-color: {{ section.settings.accent_color }};
    --rc-cta-bg: {{ section.settings.cta_background }};
    --rc-cta-text: {{ section.settings.cta_text_color }};
    --rc-device-color: {{ section.settings.device_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="section-rc-app-promo-{{ section.id }} rc-app-promo rc-app-promo--media-{{ media_position }}">
  <div class="page-width rc-app-promo__inner">
    <div class="rc-app-promo__content">
      {%- if eyebrow_text != blank -%}
        <p class="rc-app-promo__eyebrow">{{ eyebrow_text | escape }}</p>
      {%- endif -%}
      {%- if heading_text != blank -%}
        <h2 class="rc-app-promo__heading">{{ heading_text | escape }}</h2>
      {%- endif -%}
      {%- if body_text != blank -%}
        <div class="rc-app-promo__body">{{ body_text }}</div>
      {%- endif -%}

      {%- if cta_label != blank -%}
        <a class="rc-app-promo__cta" href="{{ cta_link | default: '#' }}">
          <span>{{ cta_label | escape }}</span>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path d="M5 12h14M13 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}

      {%- if app_store_link != blank or google_play_link != blank -%}
        <div class="rc-app-promo__stores">
          {%- if app_store_link != blank -%}
            <a class="rc-app-promo__store" href="{{ app_store_link }}" aria-label="Download on the App Store">
              <svg viewBox="0 0 135 40" width="135" height="40" aria-hidden="true" focusable="false">
                <rect x="0.5" y="0.5" width="134" height="39" rx="6" fill="#000000" stroke="#FFFFFF" stroke-opacity="0.15"/>
                <path d="M28.5 19.2c0-2.8 2.3-4.1 2.4-4.2-1.3-1.9-3.3-2.2-4-2.2-1.7-.2-3.3 1-4.2 1-.8 0-2.2-1-3.6-1-1.9 0-3.6 1.1-4.6 2.7-2 3.5-.5 8.6 1.4 11.4 1 1.4 2.1 2.9 3.6 2.9 1.4-.1 2-.9 3.6-.9 1.7 0 2.2.9 3.6.9 1.5 0 2.4-1.4 3.4-2.8 1.1-1.6 1.5-3.1 1.5-3.2-.1 0-2.9-1.1-2.9-4.6zM25.8 11.5c.8-1 1.3-2.3 1.1-3.7-1.1.1-2.5.8-3.3 1.7-.7.8-1.4 2.2-1.2 3.5 1.2.1 2.5-.6 3.4-1.5z" fill="#FFFFFF"/>
                <text x="42" y="17" fill="#FFFFFF" font-family="Helvetica,Arial,sans-serif" font-size="8" opacity="0.8">Download on the</text>
                <text x="42" y="30" fill="#FFFFFF" font-family="Helvetica,Arial,sans-serif" font-size="14" font-weight="600">App Store</text>
              </svg>
            </a>
          {%- endif -%}
          {%- if google_play_link != blank -%}
            <a class="rc-app-promo__store" href="{{ google_play_link }}" aria-label="Get it on Google Play">
              <svg viewBox="0 0 135 40" width="135" height="40" aria-hidden="true" focusable="false">
                <rect x="0.5" y="0.5" width="134" height="39" rx="6" fill="#000000" stroke="#FFFFFF" stroke-opacity="0.15"/>
                <path d="M16 11v18l9-9-9-9z" fill="#FFFFFF" opacity="0.85"/>
                <path d="M25 20l-9-9v3l6 6-6 6v3l9-9z" fill="#FFD400"/>
                <text x="34" y="17" fill="#FFFFFF" font-family="Helvetica,Arial,sans-serif" font-size="8" opacity="0.8">GET IT ON</text>
                <text x="34" y="30" fill="#FFFFFF" font-family="Helvetica,Arial,sans-serif" font-size="14" font-weight="600">Google Play</text>
              </svg>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="rc-app-promo__media">
      <div class="rc-app-promo__phones">
        {%- for block in section.blocks -%}
          {%- assign screen = block.settings.screen_image -%}
          <div class="rc-app-promo__phone rc-app-promo__phone--{{ forloop.index }}" {{ block.shopify_attributes }}>
            <div class="rc-app-promo__phone-frame">
              <span class="rc-app-promo__phone-notch" aria-hidden="true"></span>
              <div class="rc-app-promo__phone-screen">
                {%- if screen != blank -%}
                  {{ screen | image_url: width: 600 | image_tag:
                    loading: 'lazy',
                    widths: '300,450,600',
                    sizes: '285px',
                    alt: block.settings.alt_text,
                    class: 'rc-app-promo__phone-image'
                  }}
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .section-rc-app-promo-{{ section.id }} {
    display: block;
    width: 100%;
    background-color: var(--rc-bg, #0C0D16);
  }

  .section-rc-app-promo-{{ section.id }} .rc-app-promo__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 64px;
  }

  .section-rc-app-promo--media-right .rc-app-promo__inner {
    grid-template-areas: "content media";
  }
  .section-rc-app-promo--media-right .rc-app-promo__content { grid-area: content; }
  .section-rc-app-promo--media-right .rc-app-promo__media { grid-area: media; }

  .section-rc-app-promo--media-left .rc-app-promo__inner {
    grid-template-areas: "media content";
  }
  .section-rc-app-promo--media-left .rc-app-promo__content { grid-area: content; }
  .section-rc-app-promo--media-left .rc-app-promo__media { grid-area: media; }

  .section-rc-app-promo-{{ section.id }} .rc-app-promo__content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 620px;
    color: var(--rc-text-color, #FFFFFF);
  }

  .section-rc-app-promo-{{ section.id }} .rc-app-promo__eyebrow {
    margin: 0;
    font-family: var(--rc-body-family);
    font-weight: 700;
    font-size: 14px;
    line-height: 1.2;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rc-accent-color, #EED427);
  }

  .section-rc-app-promo-{{ section.id }} .rc-app-promo__heading {
    margin: 0;
    font-family: var(--rc-heading-family);
    font-weight: var(--rc-heading-weight);
    font-style: var(--rc-heading-style);
    font-size: clamp(24px, 2.22vw, 32px);
    line-height: 1.12;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--rc-heading-color, #FFFFFF);
  }

  .section-rc-app-promo-{{ section.id }} .rc-app-promo__body {
    font-family: var(--rc-body-family);
    font-weight: var(--rc-body-weight);
    font-style: var(--rc-body-style);
    font-size: clamp(14px, 1.05vw, 18px);
    line-height: 1.6;
    color: var(--rc-text-color, #FFFFFF);
    opacity: 0.85;
  }

  .section-rc-app-promo-{{ section.id }} .rc-app-promo__body p {
    margin: 0 0 0.75em 0;
  }

  .section-rc-app-promo-{{ section.id }} .rc-app-promo__body p:last-child {
    margin-bottom: 0;
  }

  .section-rc-app-promo-{{ section.id }} .rc-app-promo__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: max-content;
    padding: 16px 28px;
    margin-top: 8px;
    background-color: var(--rc-cta-bg, #1A4083);
    color: var(--rc-cta-text, #FFFFFF);
    border-radius: 4px;
    text-decoration: none;
    font-family: var(--rc-cta-family);
    font-weight: var(--rc-cta-weight);
    font-style: var(--rc-cta-style);
    font-size: 15px;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: filter 0.2s ease, transform 0.2s ease;
  }

  .section-rc-app-promo-{{ section.id }} .rc-app-promo__cta:hover,
  .section-rc-app-promo-{{ section.id }} .rc-app-promo__cta:focus-visible {
    filter: brightness(1.12);
    transform: translateY(-1px);
    outline: none;
  }

  .section-rc-app-promo-{{ section.id }} .rc-app-promo__stores {
    display: flex;
    gap: 12px;
    margin-top: 4px;
    flex-wrap: wrap;
  }

  .section-rc-app-promo-{{ section.id }} .rc-app-promo__store {
    display: inline-flex;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .section-rc-app-promo-{{ section.id }} .rc-app-promo__store:hover {
    transform: translateY(-1px);
    opacity: 0.9;
  }

  .section-rc-app-promo-{{ section.id }} .rc-app-promo__phones {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    align-items: center;
    justify-items: center;
    min-height: 620px;
  }

  .section-rc-app-promo-{{ section.id }} .rc-app-promo__phone {
    width: 100%;
    max-width: 220px;
    transition: transform 0.4s ease;
  }

  .section-rc-app-promo-{{ section.id }} .rc-app-promo__phone--1 {
    transform: translateY(24px) rotate(-4deg);
  }
  .section-rc-app-promo-{{ section.id }} .rc-app-promo__phone--2 {
    transform: translateY(-20px) scale(1.06);
    z-index: 2;
  }
  .section-rc-app-promo-{{ section.id }} .rc-app-promo__phone--3 {
    transform: translateY(24px) rotate(4deg);
  }

  .section-rc-app-promo-{{ section.id }} .rc-app-promo__phone-frame {
    position: relative;
    aspect-ratio: 285 / 620;
    width: 100%;
    background-color: var(--rc-device-color, #111111);
    border-radius: 34px;
    padding: 10px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5), inset 0 0 0 1.5px rgba(255, 255, 255, 0.08);
  }

  .section-rc-app-promo-{{ section.id }} .rc-app-promo__phone-notch {
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    width: 32%;
    height: 16px;
    background-color: var(--rc-device-color, #111111);
    border-radius: 999px;
    z-index: 1;
  }

  .section-rc-app-promo-{{ section.id }} .rc-app-promo__phone-screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 26px;
    overflow: hidden;
    background-color: #1A1D28;
  }

  .section-rc-app-promo-{{ section.id }} .rc-app-promo__phone-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 989px) {
    .section-rc-app-promo-{{ section.id }} .rc-app-promo__inner {
      grid-template-columns: 1fr !important;
      grid-template-areas: "content" "media" !important;
      gap: 48px;
    }
    .section-rc-app-promo-{{ section.id }} .rc-app-promo__phones {
      min-height: 0;
    }
  }

  @media screen and (max-width: 749px) {
    .section-rc-app-promo-{{ section.id }} .rc-app-promo__cta {
      width: 100%;
      justify-content: center;
      padding: 14px 20px;
    }
    .section-rc-app-promo-{{ section.id }} .rc-app-promo__phones {
      gap: 8px;
    }
    .section-rc-app-promo-{{ section.id }} .rc-app-promo__phone {
      max-width: 120px;
    }
    .section-rc-app-promo-{{ section.id }} .rc-app-promo__phone-frame {
      border-radius: 20px;
      padding: 6px;
    }
    .section-rc-app-promo-{{ section.id }} .rc-app-promo__phone-screen {
      border-radius: 14px;
    }
    .section-rc-app-promo-{{ section.id }} .rc-app-promo__phone-notch {
      top: 8px;
      height: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-rc-app-promo-{{ section.id }} .rc-app-promo__cta,
    .section-rc-app-promo-{{ section.id }} .rc-app-promo__phone,
    .section-rc-app-promo-{{ section.id }} .rc-app-promo__store {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "App promo (rc)",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "YEAH BUDDY™ APP"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Training. Your Stack. Your Progress — All in One App"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>The Yeah Buddy App helps you plan your workouts, track results, and get the most out of every RCSS supplement. Log your lifts, monitor recovery, and stay fired up with exclusive content and rewards.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary CTA label",
      "default": "DOWNLOAD HERE"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Primary CTA link"
    },
    {
      "type": "url",
      "id": "app_store_link",
      "label": "App Store link"
    },
    {
      "type": "url",
      "id": "google_play_link",
      "label": "Google Play link"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Phone mockups position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "helvetica_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "barlow_n4"
    },
    {
      "type": "font_picker",
      "id": "cta_font",
      "label": "Button font",
      "default": "barlow_n7"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#0C0D16"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Eyebrow accent",
      "default": "#EED427"
    },
    {
      "type": "color",
      "id": "cta_background",
      "label": "Button background",
      "default": "#1A4083"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "device_color",
      "label": "Phone bezel color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "screen",
      "name": "Phone screen",
      "settings": [
        {
          "type": "image_picker",
          "id": "screen_image",
          "label": "Screen image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text",
          "default": "Yeah Buddy app screen"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "App promo (rc)",
      "category": "Image",
      "blocks": [
        { "type": "screen" },
        { "type": "screen" },
        { "type": "screen" }
      ]
    }
  ]
}
{% endschema %}
