{{ 'rc-sections.css' | asset_url | stylesheet_tag }}

{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_text = section.settings.heading
  assign heading_alignment = section.settings.heading_alignment
  assign columns_desktop = section.settings.columns_desktop | default: 4
  assign columns_tablet = section.settings.columns_tablet | default: 2
  assign columns_mobile = section.settings.columns_mobile | default: 1
  assign image_ratio = section.settings.image_ratio

  assign enable_desktop_slider = section.settings.enable_desktop_slider
  assign swipe_on_mobile = section.settings.swipe_on_mobile

  assign show_desktop_slider = false
  if enable_desktop_slider and section.blocks.size > columns_desktop
    assign show_desktop_slider = true
  endif

  assign show_mobile_slider = false
  if swipe_on_mobile and section.blocks.size > columns_mobile
    assign show_mobile_slider = true
  endif

  assign is_slider = false
  if show_desktop_slider or show_mobile_slider
    assign is_slider = true
  endif

  assign heading_font = section.settings.heading_font
  assign eyebrow_font = section.settings.eyebrow_font
  assign title_font = section.settings.title_font
  assign price_font = section.settings.price_font
-%}

{%- style -%}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ eyebrow_font | font_face: font_display: 'swap' }}
  {{ title_font | font_face: font_display: 'swap' }}
  {{ price_font | font_face: font_display: 'swap' }}

  .section-rc-top-sellers-{{ section.id }} {
    --rc-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --rc-heading-weight: {{ heading_font.weight }};
    --rc-heading-style: {{ heading_font.style }};
    --rc-eyebrow-family: {{ eyebrow_font.family }}, {{ eyebrow_font.fallback_families }};
    --rc-eyebrow-weight: {{ eyebrow_font.weight }};
    --rc-eyebrow-style: {{ eyebrow_font.style }};
    --rc-title-family: {{ title_font.family }}, {{ title_font.fallback_families }};
    --rc-title-weight: {{ title_font.weight }};
    --rc-title-style: {{ title_font.style }};
    --rc-price-family: {{ price_font.family }}, {{ price_font.fallback_families }};
    --rc-price-weight: {{ price_font.weight }};
    --rc-price-style: {{ price_font.style }};
    --rc-bg: {{ section.settings.background_color }};
    --rc-heading-color: {{ section.settings.heading_color }};
    --rc-card-bg: {{ section.settings.card_background }};
    --rc-text-color: {{ section.settings.text_color }};
    --rc-glow-color: {{ section.settings.glow_color }};
    --rc-arrow-bg: {{ section.settings.arrow_background }};
    --rc-arrow-color: {{ section.settings.arrow_color }};
    --rc-card-radius: {{ section.settings.card_radius }}px;
    --rc-columns-desktop: {{ columns_desktop }};
    --rc-columns-tablet: {{ columns_tablet }};
    --rc-columns-mobile: {{ columns_mobile }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="section-rc-top-sellers-{{ section.id }} rc-top-sellers rc-top-sellers--align-{{ heading_alignment }} rc-top-sellers--ratio-{{ image_ratio }}{% if is_slider %} rc-top-sellers--has-slider{% endif %}">
  <div class="page-width rc-top-sellers__inner">
    {%- if heading_text != blank -%}
      <h2 class="rc-top-sellers__heading">{{ heading_text | escape }}</h2>
    {%- endif -%}

    <slider-component class="rc-top-sellers__slider slider-mobile-gutter">
      <ul
        id="Slider-{{ section.id }}"
        class="rc-top-sellers__grid grid grid--{{ columns_desktop }}-col-desktop grid--{{ columns_mobile }}-col-tablet-down{% if show_mobile_slider or show_desktop_slider %} slider{% if show_desktop_slider %} slider--desktop{% endif %}{% if show_mobile_slider %} slider--tablet grid--peek{% endif %}{% endif %}"
        role="list"
        aria-label="{{ heading_text | default: 'Top sellers' | escape }}"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_link = block.settings.link | default: '#'
            assign card_image = block.settings.image
            assign card_eyebrow = block.settings.eyebrow
            assign card_title = block.settings.title
            assign card_price = block.settings.price_label
          -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="rc-top-sellers__item grid__item{% if is_slider %} slider__slide{% endif %}"
            {{ block.shopify_attributes }}
          >
            <a href="{{ card_link }}" class="rc-top-sellers__card">
              <div class="rc-top-sellers__media">
                <span class="rc-top-sellers__glow" aria-hidden="true"></span>
                {%- if card_image != blank -%}
                  {{ card_image | image_url: width: 800 | image_tag:
                    loading: 'lazy',
                    widths: '200,300,400,600,800',
                    sizes: '(min-width: 990px) calc(100vw / var(--rc-columns-desktop)), (min-width: 750px) calc(100vw / var(--rc-columns-tablet)), 100vw',
                    alt: card_title,
                    class: 'rc-top-sellers__image'
                  }}
                {%- else -%}
                  <div class="rc-top-sellers__placeholder" aria-hidden="true">
                    {{ 'product-1' | placeholder_svg_tag: 'rc-top-sellers__placeholder-svg' }}
                  </div>
                {%- endif -%}
              </div>
              <div class="rc-top-sellers__body">
                {%- if card_eyebrow != blank -%}
                  <p class="rc-top-sellers__eyebrow">{{ card_eyebrow | escape }}</p>
                {%- endif -%}
                <div class="rc-top-sellers__meta">
                  {%- if card_title != blank -%}
                    <h3 class="rc-top-sellers__title">{{ card_title | escape }}</h3>
                  {%- endif -%}
                  {%- if card_price != blank -%}
                    <span class="rc-top-sellers__price">{{ card_price | escape }}</span>
                  {%- endif -%}
                </div>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>

      {%- if is_slider -%}
        <div class="rc-top-sellers__controls slider-buttons">
          <button
            type="button"
            class="rc-top-sellers__arrow slider-button slider-button--prev"
            name="previous"
            aria-label="Previous product"
            aria-controls="Slider-{{ section.id }}"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="rc-top-sellers__counter slider-counter">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">of</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>
          <button
            type="button"
            class="rc-top-sellers__arrow slider-button slider-button--next"
            name="next"
            aria-label="Next product"
            aria-controls="Slider-{{ section.id }}"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      {%- endif -%}
    </slider-component>
  </div>
</section>

{% schema %}
{
  "name": "Top sellers (rc)",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 16,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "TOP SELLERS"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_tablet",
      "label": "Columns on tablet",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to card" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ],
      "default": "adapt"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Slider",
      "info": "Slider arrows appear when there are more products than columns shown."
    },
    {
      "type": "checkbox",
      "id": "enable_desktop_slider",
      "label": "Enable slider on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "label": "Swipe slider on mobile",
      "default": true
    },
    {
      "type": "color",
      "id": "arrow_background",
      "label": "Arrow background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow color",
      "default": "#222222"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "helvetica_n7"
    },
    {
      "type": "font_picker",
      "id": "eyebrow_font",
      "label": "Eyebrow font",
      "default": "barlow_n4"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Product title font",
      "default": "barlow_n7"
    },
    {
      "type": "font_picker",
      "id": "price_font",
      "label": "Price font",
      "default": "barlow_n7"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#F6F8FB"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Card text",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Card glow",
      "default": "#1A4083"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Ronnie Coleman Signature Series"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Product title",
          "default": "YEAH BUDDY™ Pre-Workout Powder"
        },
        {
          "type": "text",
          "id": "price_label",
          "label": "Price label",
          "default": "From $34.99"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Product link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Top sellers (rc)",
      "category": "Product",
      "settings": {
        "enable_desktop_slider": true,
        "swipe_on_mobile": true
      },
      "blocks": [
        { "type": "product", "settings": { "title": "YEAH BUDDY™ Pre-Workout Powder", "price_label": "From $34.99" } },
        { "type": "product", "settings": { "title": "Yeah Buddy Sport Pre-Workout", "price_label": "From $26.99" } },
        { "type": "product", "settings": { "title": "L-Carnitine XS Liquid 3,000MG", "price_label": "From $34.99" } },
        { "type": "product", "settings": { "title": "Creatine XS Unflavoured Powder", "price_label": "From $49.99" } },
        { "type": "product", "settings": { "title": "EAA XS Amino Fuel", "price_label": "From $39.99" } },
        { "type": "product", "settings": { "title": "ISO-Tropic MAX Protein", "price_label": "From $54.99" } }
      ]
    }
  ]
}
{% endschema %}
