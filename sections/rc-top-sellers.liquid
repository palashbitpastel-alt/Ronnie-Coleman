      "default": "barlow_n7"
    },
    {
      "type": "font_picker",
      "id": "price_font",
      "label": "Price font",
      "default": "barlow_n7"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
